+
+    setDom()
+    {
+        const root = document.createElement('div')
+        root.className = 'tas'
+        root.innerHTML = /* html */`
+            <div class="tas-head">
+                <div class="tas-title"><span>TAS · <select class="tas-course js-course" title="Épreuve (la page est rechargée)">${Object.entries(COURSES).map(([ k, v ]) => `<option value="${k}"${k === this.course ? ' selected' : ''}>${v}</option>`).join('')}</select></span><span class="tas-mode js-mode">PAUSE</span></div>
+                <div class="tas-stats">
+                    <div>Image <b class="js-frame">0</b></div>
+                    <div>Chrono <b class="js-timer">00:00.000</b></div>
+                    <div>Portes <b class="js-gates">0/9</b></div>
+                    <div>Vitesse <b class="js-speed">0.0</b></div>
+                    <div>Movie <b class="js-length">0</b> img</div>
+                    <div>Lecture <b class="js-playspeed">×1</b></div>
+                </div>
+                <div class="tas-next js-next-gate"></div>
+                <div class="tas-finish js-finish"></div>
+            </div>
+            <div class="tas-buttons">
+                <button class="js-start" data-action-title="start|Retour au départ">⏮</button>
+                <button class="js-back" data-action-title="back|Image précédente, maintenir pour rembobiner">◀|</button>
+                <button class="js-play" data-action-title="play|Lecture / pause">▶</button>
+                <button class="js-next" data-action-title="next|Image suivante, maintenir pour avancer">|▶</button>
+                <button class="js-rec" data-action-title="rec|Enregistrer vos touches">● REC</button>
+                <button class="js-slower" data-action-title="slower|Plus lent">−</button>
+                <button class="js-faster" data-action-title="faster|Plus rapide">+</button>
+                <button class="js-undo" data-action-title="undo|Annuler">↶</button>
+                <button class="js-redo" data-action-title="redo|Rétablir">↷</button>
+                <button class="js-insert" data-action-title="insert|Insérer une image neutre ici">+img</button>
+                <button class="js-delete" data-action-title="delete|Supprimer l'image courante">−img</button>
+                <button class="js-truncate" title="Couper le movie après l'image courante">✂ fin</button>
+                <button class="js-save" data-action-title="save|Enregistrer le movie">💾</button>
+                <button class="js-open" data-action-title="open|Ouvrir un movie">📂</button>
+                <button class="js-settings" data-action-title="settings|Réglages : raccourcis, touches, compte à rebours">⚙</button>
+                <button class="js-help" data-action-title="help|Aide">?</button>
+            </div>
+            <div class="tas-timeline"><input class="js-timeline" type="range" min="0" max="0" value="0" step="1"></div>
+            <div class="tas-roll js-roll">
+                <div class="tas-row is-head"><div>#</div><div>Gaz</div><div>Direction (G ⟷ D)</div><div>Bst</div><div>Frn</div><div>Saut</div></div>
+                <div class="js-rows"></div>
+            </div>
+            <div class="tas-footer">Clic : modifier · glisser : peindre · molette : ±1 image (Maj : ±10) · clic droit sur Direction : 0 · ⚙ réglages</div>
+            <input class="js-file" type="file" accept=".json,application/json" hidden>
+        `
+        document.body.appendChild(root)
+
+        const flash = document.createElement('div')
+        flash.className = 'tas-flash'
+        document.body.appendChild(flash)
+
+        const help = document.createElement('div')
+        help.className = 'tas-help'
+        help.innerHTML = '<div class="tas-help-box js-help-body"></div>'
+        help.addEventListener('click', () => this.toggleHelp())
+        document.body.appendChild(help)
+
+        const settings = document.createElement('div')
+        settings.className = 'tas-help tas-settings'
+        settings.innerHTML = '<div class="tas-help-box js-settings-body"></div>'
+        document.body.appendChild(settings)
+
+        const countdown = document.createElement('div')
+        countdown.className = 'tas-countdown'
+        document.body.appendChild(countdown)
+
+        const $ = (selector) => root.querySelector(selector)
+        this.dom = {
+            root, flash, help, settings, countdown,
+            helpBody: help.querySelector('.js-help-body'), settingsBody: settings.querySelector('.js-settings-body'),
+            mode: $('.js-mode'), frame: $('.js-frame'), timer: $('.js-timer'), gates: $('.js-gates'), speed: $('.js-speed'),
+            length: $('.js-length'), playspeed: $('.js-playspeed'), finish: $('.js-finish'), nextGate: $('.js-next-gate'), course: $('.js-course'),
+            play: $('.js-play'), rec: $('.js-rec'), timeline: $('.js-timeline'), roll: $('.js-roll'), rows: $('.js-rows'), file: $('.js-file')
+        }
+
+        // Le panneau ne doit pas transmettre ses événements au jeu
+        for(const type of [ 'pointerdown', 'pointermove', 'pointerup', 'mousedown', 'mousemove', 'mouseup', 'wheel', 'touchstart', 'touchmove', 'contextmenu' ])
+            root.addEventListener(type, e => e.stopPropagation())
+
+        const on = (selector, callback) => $(selector).addEventListener('click', (e) => { callback(); e.currentTarget.blur() })
+        on('.js-start', () => this.goToStart())
+        on('.js-back', () => this.frameBack())
+        on('.js-play', () => this.togglePlay())
+        on('.js-next', () => this.frameAdvance())
+        on('.js-rec', () => this.toggleRecord())
+        on('.js-slower', () => this.changeSpeed(-1))
+        on('.js-faster', () => this.changeSpeed(1))
+        on('.js-undo', () => this.undo())
+        on('.js-redo', () => this.redo())
+        on('.js-insert', () => this.insertFrame())
+        on('.js-delete', () => this.deleteFrame())
+        on('.js-truncate', () => this.truncate())
+        on('.js-save', () => this.saveFile())
+        on('.js-open', () => this.openFile())
+        on('.js-help', () => this.toggleHelp())
+        on('.js-settings', () => this.toggleSettings())
+        this.dom.course.addEventListener('change', () => this.switchCourse(this.dom.course.value))
+
+        // Fenêtre des réglages
+        settings.addEventListener('click', (event) =>
+        {
+            const element = event.target.closest('[data-set], [data-clear], [data-action]')
+            if(event.target === settings) { this.toggleSettings(); return }
+            if(!element) return
+            if(element.dataset.set) { this.capture = { type: element.dataset.set, name: element.dataset.name, slot: Number(element.dataset.slot || 0) }; this.renderSettings() }
+            else if(element.dataset.clear) { const keys = (this.settings.driving[element.dataset.clear] || []).slice(); keys.splice(Number(element.dataset.slot), 1); this.settings.driving[element.dataset.clear] = keys; this.saveSettings(); this.renderSettings() }
+            else if(element.dataset.action === 'reset') { this.settings = this.defaultSettings(); this.saveSettings(); this.renderSettings(); this.flash('Réglages par défaut rétablis') }
+            else if(element.dataset.action === 'close') this.toggleSettings()
+        })
+        settings.addEventListener('change', (event) =>
+        {
+            if(event.target.matches('.js-countdown')) this.settings.countdown = Math.max(0, Math.min(10, Math.round(Number(event.target.value) || 0)))
+            if(event.target.matches('.js-beep')) this.settings.beep = event.target.checked
+            this.saveSettings()
+        })
+        this.updateTitles()
+        if(navigator.keyboard && navigator.keyboard.getLayoutMap)
+            navigator.keyboard.getLayoutMap().then(map => { this.layoutMap = map; this.updateTitles() }).catch(() => {})
+
+        this.dom.file.addEventListener('change', async () =>
+        {
+            const file = this.dom.file.files[0]
+            if(!file) return
+            try
+            {
+                const data = JSON.parse(await file.text())
+                const movie = this.deserialize(data)
+                const course = data.course || 'circuit'
+                if(course !== this.course)
+                {
+                    this.flash(`Movie du ${COURSES[course] || course} : changement d'épreuve…`)
+                    this.switchCourse(course, data)
+                    return
+                }
+                const oldTrack = TRACKS[course] && (data.track || 1) !== TRACKS[course]
+                this.loadMovie(movie, oldTrack
+                    ? `Attention : movie de l'ancien tracé du ${COURSES[course]} (version 1.3.0), il ne suivra pas le nouveau parcours`
+                    : `Movie chargé : ${file.name} (${movie.length} images)`)
+            }
+            catch(error) { this.flash(`Erreur : ${error.message}`) }
+        })
+
+        // Timeline
+        let pendingSeek = null
+        this.dom.timeline.addEventListener('input', () =>
+        {
+            this.playing = false
+            if(pendingSeek === null)
+                requestAnimationFrame(() => { this.seek(pendingSeek); pendingSeek = null })
+            pendingSeek = Number(this.dom.timeline.value)
+        })
+
+        // Molette sur la liste : ±1 image (Maj : ±10)
+        this.dom.roll.addEventListener('wheel', (event) =>
+        {
+            event.preventDefault()
+            this.playing = false
+            const step = (event.shiftKey ? 10 : 1) * Math.sign(event.deltaY)
+            this.seek(this.current + step)
+        }, { passive: false })
+
+        // Peinture des entrées
+        this.dom.rows.addEventListener('mousedown', (event) => this.paintStart(event))
+        window.addEventListener('mousemove', (event) => this.paintMove(event), true)
+        window.addEventListener('mouseup', () => this.paintEnd())
+        this.dom.rows.addEventListener('contextmenu', (event) =>
+        {
+            event.preventDefault()
+            const cell = event.target.closest('.cell')
+            if(cell && cell.dataset.col === 'steer')
+                this.setInputs([ Number(cell.dataset.index) ], { steer: 0 })
+        })
+    }
+
+    cellValue(cell, event, existing)
+    {
+        const col = cell.dataset.col
+        if(col === 'steer')
+        {
+            const rect = cell.getBoundingClientRect()
+            let value = ((event.clientX - rect.left) / rect.width) * 2 - 1 // gauche → -1 ; droite → +1
+            value = -value // dans le jeu : +1 = gauche, -1 = droite
+            value = Math.round(value * 20) / 20
+            if(Math.abs(value) < 0.075) value = 0
+            return { steer: Math.max(-1, Math.min(1, value)) }
+        }
+        if(col === 'throttle')
+            return { throttle: existing.throttle > 0 ? 0 : existing.throttle < 0 ? 1 : -1 }
+        if(col === 'boost') return { boost: !existing.boost }
+        if(col === 'brake') return { brake: !existing.brake }
+        if(col === 'jump') return { susp: isAllLow(existing.susp) ? JUMP.slice() : null }
+        return null
+    }
+
+    paintStart(event)
+    {
+        if(event.button !== 0) return
+        const cell = event.target.closest('.cell')
+        if(!cell) return
+        this.playing = false
+        const index = Number(cell.dataset.index)
+        const value = this.cellValue(cell, event, this.inputAt(index))
+        if(!value) return
+        this.paint = { col: cell.dataset.col, value, min: index, indices: new Set([ index ]) }
+        this.applyPaint(index, cell, event)
+    }
+
+    paintMove(event)
+    {
+        if(!this.paint) return
+        // Sécurité : bouton déjà relâché (relâchement hors de la fenêtre, etc.)
+        if(event.buttons === 0) { this.paintEnd(); return }
+        const hovered = document.elementFromPoint(event.clientX, event.clientY)
+        const cell = hovered && hovered.closest && hovered.closest('.tas-row .cell')
+        if(!cell || cell.dataset.col !== this.paint.col) return
+        const index = Number(cell.dataset.index)
+        this.paint.indices.add(index)
+        this.paint.min = Math.min(this.paint.min, index)
+        this.applyPaint(index, cell, event)
+    }
+
+    applyPaint(index, cell, event)
+    {
+        // Direction : la valeur suit la souris ; autres colonnes : même valeur que le premier clic
+        const value = this.paint.col === 'steer' ? this.cellValue(cell, event, this.inputAt(index)) : this.paint.value
+        if(!this.paint.history) { this.paint.history = true }
+        this.extendMovie(index + 1)
+        if(!this.paint.saved) this.paint.saved = new Map()
+        if(!this.paint.saved.has(index)) this.paint.saved.set(index, { ...this.movie[index] })
+        this.movie[index] = { ...this.movie[index], ...value }
+        this.dirty = true
+        this.rowsDirty = true
+    }
+
+    paintEnd()
+    {
+        if(!this.paint) return
+        const paint = this.paint
+        this.paint = null
+        // Historique : état d'avant la peinture
+        this.history.length = this.historyIndex + 1
+        this.history.push({ entry: [ ...paint.saved.entries() ].map(([ i, v ]) => [ i, v ]), length: this.movie.length })
+        this.historyIndex = this.history.length - 1
+        this.resync(paint.min)
+    }
+
+    toggleHelp()
+    {
+        const label = (name) => this.bindingLabel(this.settings.bindings[name])
+        const driving = DRIVING_ACTIONS.map(([ name, text ]) => `${text} : ${(this.settings.driving[name] || []).map(code => this.keyLabel(code, this.keyLabels?.[code])).join(' / ') || '—'}`).join(' · ')
+        this.dom.helpBody.innerHTML = /* html */`
+            <h2>Éditeur TAS — raccourcis</h2>
+            <table>
+                ${EDITOR_ACTIONS.map(([ name, text ]) => `<tr><td>${label(name)}</td><td>${text}</td></tr>`).join('')}
+                <tr><td>F9</td><td>Quitter le mode TAS (retour au jeu normal)</td></tr>
+            </table>
+            <p>Conduite (en REC) : ${driving}</p>
+            <p>Méthode classique : en pause, activez REC, maintenez les touches voulues et avancez image par image. Revenez en arrière pour corriger : la suite du movie est conservée, la course est recalculée exactement.</p>
+            <p>L'image 0 est celle du départ : le chrono vaut 00:00.000 avant elle et avance de 1/60 s par image. En REC ou depuis l'image 0, la lecture commence après un compte à rebours (réglable dans ⚙).</p>
+            <p>Raccourcis, touches et compte à rebours se modifient dans les réglages (⚙, ${label('settings')}).</p>`
+        this.dom.help.classList.toggle('is-visible')
+    }
+
+    flash(message)
+    {
+        this.dom.flash.textContent = message
+        this.dom.flash.classList.add('is-visible')
+        this.tas.real.clearTimeout(this.flashTimeout)
+        this.flashTimeout = this.tas.real.setTimeout(() => this.dom.flash.classList.remove('is-visible'), 2200)
+    }
+
+    updateDom()
+    {
+        const current = this.current
+        const circuit = this.circuit
+        const d = this.dom
+
+        const playing = this.playing || !!this.countdown
+        d.mode.textContent = this.countdown ? (this.recording ? 'REC · départ…' : 'départ…') : this.recording ? (this.playing ? 'REC ▶' : 'REC') : this.playing ? 'LECTURE' : 'PAUSE'
+        d.mode.className = 'tas-mode js-mode' + (this.recording ? ' is-rec' : playing ? ' is-play' : '')
+        d.frame.textContent = current
+        const raceTime = this.finish && current >= this.finish.frame ? this.finish.time : current / this.tas.fps
+        d.timer.textContent = formatTime(raceTime)
+        const totalGates = circuit.checkpoints.count + 2
+        d.gates.textContent = `${Math.min(circuit.checkpoints.reachedCount, totalGates)}/${totalGates}`
+        const target = circuit.checkpoints.target
+        const nextLabel = this.finish && current >= this.finish.frame ? '' : !target ? '' : circuit.checkpoints.reachedCount === totalGates - 1 ? 'Arrivée' : target.label || (circuit.checkpoints.reachedCount === 0 ? 'Ligne de départ' : `Circuit ${target.index}`)
+        if(d.nextGate.textContent !== (nextLabel ? `Prochaine porte : ${nextLabel}` : '')) d.nextGate.textContent = nextLabel ? `Prochaine porte : ${nextLabel}` : ''
+        d.speed.textContent = (this.game.physicalVehicle.speed || 0).toFixed(1)
+        d.length.textContent = this.movie.length
+        d.playspeed.textContent = `×${SPEEDS[this.speedIndex]}`
+        d.play.textContent = this.playing ? '⏸' : '▶'
+        d.rec.classList.toggle('is-on', this.recording)
+        d.finish.textContent = this.finish ? `🏁 Arrivée ${formatTime(this.finish.time)} · image ${this.finish.frame}` : ''
+
+        const max = Math.max(this.movie.length, current, 1)
+        if(Number(d.timeline.max) !== max) d.timeline.max = max
+        if(document.activeElement !== d.timeline) d.timeline.value = current
+
+        if(this.rowsDirty || this.rowsKey() !== this.lastRowsKey)
+            this.renderRows()
+    }
+
+    rowsKey()
+    {
+        return `${this.current}|${this.movie.length}|${this.greenzone.size}|${this.fineCache.size}|${this.finish ? this.finish.frame : -1}`
+    }
+
+    renderRows()
+    {
+        this.rowsDirty = false
+        this.lastRowsKey = this.rowsKey()
+        const current = this.current
+        const start = Math.max(0, current - ROWS_BEFORE)
+        const end = start + ROWS_BEFORE + ROWS_AFTER
+        let html = ''
+        for(let i = start; i < end; i++)
+        {
+            const exists = i < this.movie.length
+            const input = this.inputAt(i)
+            const classes = [ 'tas-row' ]
+            if(i < current) classes.push('is-past')
+            if(i === current) classes.push('is-current')
+            if(!exists) classes.push('is-empty')
+            if(this.finish && i === this.finish.frame - 1) classes.push('is-finish')
+
+            const throttle = input.throttle > 0 ? (input.throttle === 1 ? '▲' : input.throttle.toFixed(2)) : input.throttle < 0 ? (input.throttle === -1 ? '▼' : input.throttle.toFixed(2)) : '·'
+            const steer = input.steer
+            const width = Math.abs(steer) * 50
+            const left = steer > 0 ? 50 - width : 50 // +1 = gauche
+            const steerLabel = steer === 0 ? '' : `${steer > 0 ? 'G' : 'D'} ${Math.abs(steer).toFixed(2)}`
+            const susp = isAllLow(input.susp) ? '·' : input.susp.every(s => s === 'high') ? '⤒' : input.susp.map(s => s[0].toUpperCase()).join('')
+
+            html += `<div class="${classes.join(' ')}">` +
+                `<div class="num${this.greenzone.has(i) ? ' has-state' : ''}">${i}</div>` +
+                `<div class="cell" data-col="throttle" data-index="${i}">${throttle}</div>` +
+                `<div class="cell" data-col="steer" data-index="${i}"><span class="tas-steer-axis"></span>${steer ? `<span class="tas-steer" style="left:${left}%;width:${width}%"></span>` : ''}<span class="tas-steer-label">${steerLabel}</span></div>` +
+                `<div class="cell${input.boost ? ' on-boost' : ''}" data-col="boost" data-index="${i}">${input.boost ? '⚡' : '·'}</div>` +
+                `<div class="cell${input.brake ? ' on-brake' : ''}" data-col="brake" data-index="${i}">${input.brake ? '■' : '·'}</div>` +
+                `<div class="cell${isAllLow(input.susp) ? '' : ' on-jump'}" data-col="jump" data-index="${i}">${susp}</div>` +
+                `</div>`
+        }
+        this.dom.rows.innerHTML = html
+    }
+}

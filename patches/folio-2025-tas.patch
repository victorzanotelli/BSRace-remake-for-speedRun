+            // Réglages : on attend une touche à affecter
+            if(this.capture) { this.captureKey(event); return true }
+            if(typing) return false
+
+            // Réglages ouverts : Échap ferme
+            if(this.dom.settings.classList.contains('is-visible') && event.code === 'Escape') { this.toggleSettings(); return true }
+
+            const action = this.matchAction(event)
+            if(!action) return false
+            if(event.repeat && NO_REPEAT.has(action)) return true
+            this.runAction(action, event)
+            return true

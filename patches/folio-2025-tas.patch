diff --git a/sources/Game/KeyBindings.js b/sources/Game/KeyBindings.js
new file mode 100644
index 0000000..350bf46
--- /dev/null
+++ b/sources/Game/KeyBindings.js
@@ -0,0 +1,365 @@
+import { Game } from './Game.js'
+
+/**
+ * Touches personnalisables du jeu normal (hors mode TAS)
+ * - les réglages sont partagés avec l'éditeur TAS (même enregistrement, partie « driving ») : une seule configuration
+ * - ouverture : bouton « Touches » du menu Options, ou F10
+ * - seules les touches du clavier changent ; la manette garde sa configuration
+ */
+const SETTINGS_KEY = 'bs-tas-settings'
+export const BINDABLE_ACTIONS = [
+    [ 'forward', 'Avancer' ],
+    [ 'backward', 'Reculer' ],
+    [ 'left', 'Gauche' ],
+    [ 'right', 'Droite' ],
+    [ 'boost', 'Boost' ],
+    [ 'brake', 'Frein' ],
+    [ 'suspensions', 'Saut' ],
+    [ 'respawn', 'Replacer la voiture' ],
+    [ 'circuitRestart', 'Recommencer la course' ],
+    [ 'honk', 'Klaxon' ]
+]
+// Actions qui ne servent jamais en même temps (balade / course) : elles peuvent partager une touche
+const SHARABLE = [ [ 'respawn', 'circuitRestart' ] ]
+const canShare = (a, b) => SHARABLE.some(([ x, y ]) => (a === x && b === y) || (a === y && b === x))
+const ACTION_LABELS = {
+    forward: 'Avancer', backward: 'Reculer', left: 'Gauche', right: 'Droite', boost: 'Boost', brake: 'Frein', suspensions: 'Saut',
+    respawn: 'Replacer la voiture', circuitRestart: 'Recommencer la course', honk: 'Klaxon', interact: 'Interagir',
+    map: 'Carte', mute: 'Couper le son', whisper: 'Murmure', viewToggle: 'Changer de vue', close: 'Menu', introStart: 'Démarrer', suspensionsFront: 'Suspensions avant', suspensionsBack: 'Suspensions arrière',
+    suspensionsRight: 'Suspensions droite', suspensionsLeft: 'Suspensions gauche', suspensionsFrontLeft: 'Suspension avant gauche',
+    suspensionsFrontRight: 'Suspension avant droite', suspensionsBackRight: 'Suspension arrière droite', suspensionsBackLeft: 'Suspension arrière gauche'
+}
+const KEY_NAMES = {
+    ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→', Space: 'Espace', ShiftLeft: 'Maj gauche', ShiftRight: 'Maj droite',
+    ControlLeft: 'Ctrl gauche', ControlRight: 'Ctrl droite', AltLeft: 'Alt', AltRight: 'Alt Gr', Insert: 'Inser', Delete: 'Suppr',
+    Enter: 'Entrée', Backspace: 'Retour arrière', Tab: 'Tab', Escape: 'Échap', PageUp: 'Pg préc', PageDown: 'Pg suiv', Home: 'Début', End: 'Fin'
+}
+// Touches réservées (menu, plein écran, outils, cette fenêtre)
+const RESERVED = new Set([ 'Escape', 'F9', 'F10', 'F11', 'F12' ])
+
+export class KeyBindings
+{
+    constructor()
+    {
+        this.game = Game.getInstance()
+        this.isOpen = false
+        this.capture = null
+
+        // Touches d'origine du jeu (pour « Réinitialiser »). Certaines actions sont déclarées plus tard
+        // (« Recommencer la course » par le circuit) : on les prend au moment où elles sont ajoutées.
+        this.defaults = {}
+        const collectDefaults = () =>
+        {
+            for(const [ name ] of BINDABLE_ACTIONS)
+                if(!this.defaults[name] && this.game.inputs.actions.has(name))
+                    this.defaults[name] = this.keyboardCodes(name).slice(0, 2)
+        }
+        collectDefaults()
+        const originalAddActions = this.game.inputs.addActions.bind(this.game.inputs)
+        this.game.inputs.addActions = (actions) =>
+        {
+            const result = originalAddActions(actions)
+            collectDefaults()
+            this.load()
+            this.apply()
+            return result
+        }
+
+        this.load()
+        this.apply()
+        this.setLayout()
+        this.setElement()
+        this.setMenuButton()
+        this.setShortcut()
+    }
+
+    keyboardCodes(name)
+    {
+        return (this.game.inputs.actions.get(name)?.keys || []).filter(key => key.startsWith('Keyboard.')).map(key => key.slice(9))
+    }
+
+    load()
+    {
+        let saved = null
+        try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || 'null') } catch(error) {}
+        this.stored = saved && typeof saved === 'object' ? saved : {}
+        this.bindings = {}
+        for(const [ name ] of BINDABLE_ACTIONS)
+        {
+            const codes = this.stored.driving?.[name]
+            this.bindings[name] = Array.isArray(codes) ? codes.filter(Boolean).slice(0, 2) : (this.defaults[name] || []).slice()
+        }
+    }
+
+    save()
+    {
+        // On relit l'enregistrement pour ne pas écraser les réglages de l'éditeur TAS (raccourcis, compte à rebours…)
+        let saved = null
+        try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || 'null') } catch(error) {}
+        saved = saved && typeof saved === 'object' ? saved : {}
+        const known = Object.fromEntries(Object.entries(this.bindings).filter(([ name ]) => this.defaults[name]))
+        saved.driving = { ...(saved.driving || {}), ...known }
+        try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(saved)) } catch(error) {}
+        this.apply()
+    }
+
+    apply()
+    {
+        for(const [ name ] of BINDABLE_ACTIONS)
+        {
+            const action = this.game.inputs.actions.get(name)
+            if(!action || !this.defaults[name])
+                continue
+            action.keys = action.keys.filter(key => !key.startsWith('Keyboard.')).concat(this.bindings[name].map(code => `Keyboard.${code}`))
+        }
+    }
+
+    setLayout()
+    {
+        // Noms des touches selon la disposition du clavier (AZERTY…), si le navigateur le permet
+        this.layoutMap = null
+        navigator.keyboard?.getLayoutMap?.().then(map => { this.layoutMap = map; if(this.isOpen) this.render() }).catch(() => {})
+    }
+
+    keyLabel(code)
+    {
+        if(KEY_NAMES[code]) return KEY_NAMES[code]
+        const fromLayout = this.layoutMap?.get(code)
+        if(fromLayout) return fromLayout.toUpperCase()
+        if(code.startsWith('Key')) return code.slice(3)
+        if(code.startsWith('Digit')) return code.slice(5)
+        if(code.startsWith('Numpad')) return 'Pavé ' + code.slice(6)
+        return code
+    }
+
+    // Autres actions du jeu (non modifiables ici) qui utilisent déjà cette touche
+    otherUses(code)
+    {
+        const bindable = new Set(BINDABLE_ACTIONS.map(([ name ]) => name))
+        // le jeu reconnaît certaines touches par leur caractère (« m » pour la carte) : on teste aussi le caractère
+        const character = (this.layoutMap?.get(code) || (code.startsWith('Key') ? code.slice(3) : '')).toLowerCase()
+        const uses = []
+        for(const [ name, action ] of this.game.inputs.actions)
+            if(!bindable.has(name) && name !== 'introStart' && (action.keys.includes(`Keyboard.${code}`) || (character && action.keys.includes(`Keyboard.${character}`))))
+                uses.push(ACTION_LABELS[name] || name)
+        return [ ...new Set(uses) ]
+    }
+
+    setElement()
+    {
+        const style = document.createElement('style')
+        style.textContent = `
+            .kb-overlay { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; background: rgba(8, 8, 14, 0.55); font: 15px/1.35 system-ui, sans-serif; color: #f2f2f7; }
+            .kb-overlay.is-open { display: flex; }
+            .kb-panel { width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; background: #17171f; border: 1px solid #2c2c3a; border-radius: 14px; padding: 20px 22px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5); }
+            .kb-title { font-size: 20px; font-weight: 700; margin: 0 0 4px; }
+            .kb-help { color: #a8a8b8; font-size: 13px; margin: 0 0 14px; }
+            .kb-table { width: 100%; border-collapse: collapse; }
+            .kb-table td { padding: 3px 0; vertical-align: middle; }
+            .kb-table td:first-child { padding-right: 12px; }
+            .kb-slot { min-width: 118px; margin-left: 6px; padding: 5px 10px; border-radius: 8px; border: 1px solid #353546; background: #22222d; color: inherit; font: inherit; cursor: pointer; }
+            .kb-slot:hover { border-color: #32ffc1; }
+            .kb-slot.is-empty { color: #6e6e80; }
+            .kb-slot.is-capturing { border-color: #32ffc1; background: #1d3a33; color: #32ffc1; }
+            .kb-message { min-height: 20px; margin: 10px 0 0; font-size: 13px; color: #ffcf5a; }
+            .kb-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; }
+            .kb-button { padding: 8px 14px; border-radius: 8px; border: 1px solid #353546; background: #22222d; color: inherit; font: inherit; cursor: pointer; }
+            .kb-button.is-primary { background: #32ffc1; border-color: #32ffc1; color: #10241e; font-weight: 700; }
+        `
+        document.head.appendChild(style)
+
+        this.element = document.createElement('div')
+        this.element.className = 'kb-overlay'
+        this.element.innerHTML = `
+            <div class="kb-panel" role="dialog" aria-label="Touches">
+                <p class="kb-title">Touches</p>
+                <p class="kb-help">Cliquez sur une case puis appuyez sur la nouvelle touche. Échap : annuler · Retour arrière : vider la case. Ces touches servent aussi à l'enregistrement dans l'éditeur TAS. La manette n'est pas modifiée.</p>
+                <table class="kb-table"><tbody class="js-kb-rows"></tbody></table>
+                <p class="kb-message js-kb-message"></p>
+                <div class="kb-actions">
+                    <button class="kb-button js-kb-reset">Réinitialiser</button>
+                    <button class="kb-button is-primary js-kb-close">Fermer</button>
+                </div>
+            </div>
+        `
+        document.body.appendChild(this.element)
+
+        this.rowsElement = this.element.querySelector('.js-kb-rows')
+        this.messageElement = this.element.querySelector('.js-kb-message')
+        this.element.querySelector('.js-kb-close').addEventListener('click', () => this.close())
+        this.element.querySelector('.js-kb-reset').addEventListener('click', () =>
+        {
+            for(const [ name ] of BINDABLE_ACTIONS)
+                this.bindings[name] = (this.defaults[name] || []).slice()
+            this.save()
+            this.message('Touches d\'origine rétablies')
+            this.render()
+        })
+        this.element.addEventListener('click', (event) =>
+        {
+            if(event.target === this.element) this.close()
+            const slot = event.target.closest('.kb-slot')
+            if(slot)
+            {
+                this.capture = { name: slot.dataset.name, index: +slot.dataset.index }
+                this.message('Appuyez sur la nouvelle touche…')
+                this.render()
+            }
+        })
+
+        // Pendant que la fenêtre est ouverte, le jeu ne reçoit pas le clavier
+        const block = (event) =>
+        {
+            if(!this.isOpen)
+                return
+            event.stopImmediatePropagation()
+            if(event.type === 'keydown' && event.code !== 'F11' && event.code !== 'F12')
+                event.preventDefault()
+            if(event.type === 'keydown')
+                this.onKey(event)
+        }
+        window.addEventListener('keydown', block, true)
+        window.addEventListener('keyup', block, true)
+    }
+
+    onKey(event)
+    {
+        if(event.repeat)
+            return
+
+        if(!this.capture)
+        {
+            if(event.code === 'Escape' || event.code === 'F10')
+                this.close()
+            return
+        }
+
+        const { name, index } = this.capture
+        if(event.code === 'Escape')
+        {
+            this.capture = null
+            this.message('')
+            this.render()
+            return
+        }
+        if(event.code === 'Backspace' || event.code === 'Delete')
+        {
+            this.bindings[name].splice(index, 1)
+            this.capture = null
+            this.save()
+            this.message('')
+            this.render()
+            return
+        }
+        if(RESERVED.has(event.code))
+        {
+            this.message(`${this.keyLabel(event.code)} est réservée, choisissez une autre touche.`)
+            return
+        }
+
+        // Une touche ne sert qu'à une action : on la retire des autres
+        const notes = []
+        for(const [ other, label ] of BINDABLE_ACTIONS)
+        {
+            if(other === name || canShare(name, other)) continue
+            const position = this.bindings[other].indexOf(event.code)
+            if(position !== -1)
+            {
+                this.bindings[other].splice(position, 1)
+                notes.push(`retirée de « ${label} »`)
+            }
+        }
+        const codes = this.bindings[name].filter(code => code !== event.code)
+        codes[Math.min(index, codes.length)] = event.code
+        this.bindings[name] = codes.filter(Boolean).slice(0, 2)
+        this.capture = null
+        this.save()
+
+        const others = this.otherUses(event.code)
+        if(others.length)
+            notes.push(`attention, le jeu s'en sert aussi pour : ${others.join(', ')}`)
+        this.message(notes.length ? `${this.keyLabel(event.code)} : ${notes.join(' ; ')}` : '')
+        this.render()
+    }
+
+    message(text)
+    {
+        this.messageElement.textContent = text
+    }
+
+    render()
+    {
+        this.rowsElement.innerHTML = BINDABLE_ACTIONS.map(([ name, label ]) =>
+        {
+            const slots = [ 0, 1 ].map(index =>
+            {
+                const code = this.bindings[name][index]
+                const capturing = this.capture && this.capture.name === name && this.capture.index === index
+                const text = capturing ? '…' : code ? this.keyLabel(code) : '—'
+                return `<button class="kb-slot${capturing ? ' is-capturing' : ''}${code ? '' : ' is-empty'}" data-name="${name}" data-index="${index}">${text}</button>`
+            }).join('')
+            return `<tr><td>${label}</td><td style="text-align: right">${slots}</td></tr>`
+        }).join('')
+    }
+
+    open()
+    {
+        if(this.isOpen)
+            return
+        this.isOpen = true
+        this.capture = null
+        this.message('')
+        this.render()
+        this.element.classList.add('is-open')
+
+        // Relâche les touches tenues avant l'ouverture (sinon la voiture continuerait d'avancer)
+        for(const [ name ] of BINDABLE_ACTIONS)
+            for(const code of this.keyboardCodes(name))
+                this.game.inputs.end(`Keyboard.${code}`)
+    }
+
+    close()
+    {
+        if(!this.isOpen)
+            return
+        this.isOpen = false
+        this.capture = null
+        this.element.classList.remove('is-open')
+    }
+
+    setMenuButton()
+    {
+        // Ligne « Touches » dans le menu Options du jeu
+        const tbody = this.game.menu.items.get('options')?.contentElement?.querySelector('table.options tbody')
+        if(!tbody)
+            return
+        const row = document.createElement('tr')
+        row.innerHTML = `
+            <td>Touches</td>
+            <td>
+                <button class="js-keybindings button is-small has-tooltip">
+                    <div class="tooltip">Changer les touches du clavier (F10)</div>
+                    Modifier
+                </button>
+            </td>
+        `
+        tbody.insertBefore(row, tbody.firstElementChild?.nextElementSibling?.nextElementSibling || null)
+        row.querySelector('.js-keybindings').addEventListener('click', () =>
+        {
+            this.game.menu.close()
+            this.open()
+        })
+    }
+
+    setShortcut()
+    {
+        window.addEventListener('keydown', (event) =>
+        {
+            if(event.code === 'F10' && !this.isOpen && !event.repeat)
+            {
+                event.preventDefault()
+                this.open()
+            }
+        })
+    }
+}

+            else if(element.dataset.clear) { const keys = (this.settings.driving[element.dataset.clear] || []).slice(); keys.splice(Number(element.dataset.slot), 1); this.settings.driving[element.dataset.clear] = keys; this.saveSettings(); this.renderSettings() }

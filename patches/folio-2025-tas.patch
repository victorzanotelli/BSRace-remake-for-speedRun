index 0000000..5615c83
--- /dev/null
+++ b/sources/Game/Tas.js
@@ -0,0 +1,710 @@
+/**
+ * Mode TAS (activé par "#tas" dans l'URL)
+ *
+ * Rend le jeu entièrement déterministe :
+ * - plus de boucle requestAnimationFrame : le jeu n'avance que via tas.step()
+ * - temps virtuel à pas fixe (60 images/s) pour le ticker, gsap et Date.now
+ * - Math.random à graine fixe
+ * - entrées du véhicule lues depuis un "movie" (une entrée par image)
+ *
+ * Doit être importé AVANT Game.js (voir index.js).
+ */
+import gsap from 'gsap'
+import seedrandom from 'seedrandom'
+import { TasEditor } from './TasEditor.js'
+import { timeToRaceString } from './utilities/time.js'
+
+const FPS = 60
+const BASE_DATE = Date.UTC(2026, 0, 15, 12, 0, 0) // date fixe (saison/jour constants)
+
+export const tas = {
+    active: /(^|[#&])tas\b/i.test(location.hash),
+    fps: FPS,
+    frame: 0,            // nombre d'images simulées depuis la prise de contrôle
+    render: false,       // dessiner chaque image (lent, utile pour la vidéo)
+    input: null,         // entrée courante { throttle, steer, boost, brake, jump, susp }
+    raceStartFrame: null,
+    log: null            // tableau optionnel d'états enregistrés
+}
+
+/**
+ * F9 : bascule jeu normal ⟷ éditeur TAS (rechargement complet de la page)
+ */
+window.addEventListener('keydown', (event) =>
+{
+    if(event.code !== 'F9' || event.repeat) return
+    event.preventDefault()
+    const debug = /(^|[#&])debug\b/i.test(location.hash) ? 'debug' : null
+    const toTas = !tas.active
+    const hash = [ debug, toTas ? 'tas&skip&editor' : null ].filter(Boolean).join('&')
+    location.href = location.pathname + `?mode=${toTas ? 'tas' : 'play'}` + (hash ? '#' + hash : '')
+}, true)
+if(/(^|[#&])editor\b/i.test(location.hash)) document.title = 'BS Folio Race — éditeur TAS'
+
+if(tas.active)
+{
+    window.__TAS__ = tas
+    window.tas = tas
+    tas.editorRequested = /(^|[#&])editor\b/i.test(location.hash)
+
+    // Hasard reproductible : une source pour le jeu (sauvegardée dans les savestates), une autre pour
+    // tout ce qui s'exécute hors des images (sons, interface) afin de ne pas perturber celle du jeu
+    let gameRandom = seedrandom('bs-folio-tas', { state: true })
+    const outsideRandom = seedrandom('bs-folio-tas-outside')
+    Math.random = gameRandom
+    tas.started = false
+
+    // Temps virtuel
+    let virtualMs = 0
+    Date.now = () => BASE_DATE + virtualMs
+
+    // Minuteries virtuelles : setTimeout/setInterval du jeu se déclenchent en temps virtuel, à l'intérieur
+    // des images (sinon elles s'intercaleraient en temps réel entre les images et rendraient le jeu non reproductible).
+    // Avant la première image, setTimeout reste réel (chargement) ; setInterval est toujours virtuel.
+    tas.real = {
+        setTimeout: window.setTimeout.bind(window),
+        clearTimeout: window.clearTimeout.bind(window),
+        setInterval: window.setInterval.bind(window),
+        clearInterval: window.clearInterval.bind(window)
+    }
+    const timers = new Map()
+    let timerId = 1e9
+    const addTimer = (callback, delay, args, repeat) =>
+    {
+        const id = ++timerId
+        delay = Math.max(0, Number(delay) || 0)
+        timers.set(id, { id, callback, args, time: virtualMs + (repeat ? Math.max(1, delay) : delay), interval: repeat ? Math.max(1, delay) : null })
+        return id
+    }
+    window.setTimeout = (callback, delay, ...args) =>
+    {
+        if(typeof callback !== 'function' || !tas.started) return tas.real.setTimeout(callback, delay, ...args)
+        return addTimer(callback, delay, args, false)
+    }
+    window.setInterval = (callback, delay, ...args) =>
+    {
+        if(typeof callback !== 'function') return tas.real.setInterval(callback, delay, ...args)
+        return addTimer(callback, delay, args, true)
+    }
+    window.clearTimeout = window.clearInterval = (id) =>
+    {
+        if(timers.has(id)) timers.delete(id)
+        else { tas.real.clearTimeout(id); tas.real.clearInterval(id) }
+    }
+    const runTimers = () =>
+    {
+        for(;;)
+        {
+            let next = null
+            for(const timer of timers.values())
+                if(timer.time <= virtualMs && (!next || timer.time < next.time || (timer.time === next.time && timer.id < next.id)))
+                    next = timer
+            if(!next) return
+            if(next.interval) next.time += next.interval
+            else timers.delete(next.id)
+            next.callback(...next.args)
+        }
+    }
+    tas.timers = timers
+
+    // gsap piloté à la main
+    gsap.ticker.remove(gsap.updateRoot)
+    gsap.ticker.lagSmoothing(0)
+    tas.gsap = gsap
+
+    /**
+     * Entrées "en direct" (clavier + manette) pour l'enregistrement, même logique que Player
+     */
+    tas.keys = new Set()
+    tas.liveInput = () =>
+    {
+        const on = (name) => (tas.keyMap?.[name] || []).some(code => tas.keys.has(code))
+        let throttle = 0, steer = 0
+        let boost = on('boost'), brake = on('brake'), jump = on('suspensions')
+        if(on('forward')) throttle += 1
+        if(on('backward')) throttle -= 1
+        if(on('right')) steer -= 1
+        if(on('left')) steer += 1
+        const parts = {
+            front: on('suspensionsFront'), back: on('suspensionsBack'), right: on('suspensionsRight'), left: on('suspensionsLeft'),
+            fl: on('suspensionsFrontLeft'), fr: on('suspensionsFrontRight'), br: on('suspensionsBackRight'), bl: on('suspensionsBackLeft')
+        }
+
+        // Manette (disposition standard) : stick gauche, R2/L2, rond = boost, carré = frein, triangle = saut
+        const pad = navigator.getGamepads ? [ ...navigator.getGamepads() ].find(Boolean) : null
+        if(pad)
+        {
+            const button = (i) => pad.buttons[i] ? pad.buttons[i].value : 0
+            const r2 = button(7), l2 = button(6)
+            if(throttle === 0 && (r2 > 0.05 || l2 > 0.05)) throttle = r2 - l2
+            const x = pad.axes[0] || 0
+            if(steer === 0 && Math.abs(x) > 0.15) steer = -Math.sign(x) * Math.min(1, (Math.abs(x) - 0.15) / 0.85)
+            boost = boost || button(1) > 0.5
+            brake = brake || button(2) > 0.5
+            jump = jump || button(3) > 0.5
+            parts.right = parts.right || button(5) > 0.5
+            parts.left = parts.left || button(4) > 0.5
+        }
+        if(brake) throttle = 0
+
+        const level = jump ? 'high' : 'mid'
+        const susp = [
+            jump || parts.front || parts.right || parts.fr,
+            jump || parts.front || parts.left || parts.fl,
+            jump || parts.back || parts.right || parts.br,
+            jump || parts.back || parts.left || parts.bl
+        ].map(active => active ? level : 'low')
+        return { throttle, steer, boost, brake, susp }
+    }
+
+    const game = () => window.game
+
+    /**
+     * Avance d'une image (ou n images)
+     */
+    tas.step = (count = 1) =>
+    {
+        const g = game()
+        tas.started = true
+        Math.random = tas.randomHook ? () => { tas.randomHook(); return gameRandom() } : gameRandom
+        try
+        {
+            for(let i = 0; i < count; i++)
+            {
+                tas.frame++
+                virtualMs = tas.frame * 1000 / FPS
+                runTimers()
+                gsap.updateRoot(virtualMs / 1000)
+                // Départ de la course piloté par le TAS : il a lieu au début de l'image, avant les entrées,
+                // pour que l'entrée 0 du movie s'applique à l'image même du départ
+                if(tas.pendingStart && tas.frame >= tas.pendingStart.frame)
+                {
+                    const start = tas.pendingStart
+                    tas.pendingStart = null
+                    start.callback()
+                }
+                g.ticker.update(virtualMs)
+                if(tas.log && tas.raceStartFrame !== null)
+                    tas.log.push(tas.state())
+            }
+        }
+        finally
+        {
+            Math.random = outsideRandom
+        }
+        return tas.frame
+    }
+
+    /**
+     * Avance jusqu'à ce qu'une condition soit vraie (max images)
+     */
+    tas.stepUntil = (predicate, max = 60 * 60) =>
+    {
+        for(let i = 0; i < max; i++)
+        {
+            if(predicate()) return true
+            tas.step()
+        }
+        return predicate()
+    }
+
+    /**
+     * État courant (pour comparer les trajectoires)
+     */
+    tas.state = () =>
+    {
+        const g = game()
+        const body = g.physicalVehicle.chassis.physical.body
+        const t = body.translation()
+        const r = body.rotation()
+        const v = body.linvel()
+        const w = body.angvel()
+        const c = g.world.areas.circuit
+        return {
+            f: tas.frame - (tas.raceStartFrame ?? 0),
+            p: [ t.x, t.y, t.z ],
+            q: [ r.x, r.y, r.z, r.w ],
+            v: [ v.x, v.y, v.z ],
+            w: [ w.x, w.y, w.z ],
+            timer: c.timer.elapsedTime,
+            reached: c.checkpoints.reachedCount,
+            state: c.state
+        }
+    }
+
+    /**
+     * Savestates
+     *
+     * Physique : snapshot Rapier restauré "en place" (les objets JS du jeu gardent leurs références).
+     * Jeu : copie des valeurs simples (nombres, vecteurs, tableaux) des modules qui influencent la course.
+     * gsap ne se sauvegarde pas : un savestate n'est pris qu'à une image "sûre" (aucun délai
+     * influençant la course en attente) et, à la restauration, les animations créées depuis sont annulées.
+     */
+    const isVector = v => v && (v.isVector2 || v.isVector3 || v.isVector4 || v.isQuaternion || v.isEuler)
+    const isPlainArray = v => Array.isArray(v) && Object.keys(v).length === v.length && v.every(x => x === null || (typeof x !== 'object' && typeof x !== 'function') || isPlainArray(x))
+    const isPlainObject = v => v && Object.getPrototypeOf(v) === Object.prototype
+
+    const captureFields = (object, depth = 2, skip = []) =>
+    {
+        const out = {}
+        for(const key of Object.keys(object))
+        {
+            if(skip.includes(key)) continue
+            const value = object[key]
+            const type = typeof value
+            if(value === null || value === undefined || type === 'number' || type === 'boolean' || type === 'string')
+                out[key] = { t: 'p', v: value }
+            else if(isVector(value))
+                out[key] = { t: 'v', v: value.toArray() }
+            else if(isPlainArray(value))
+                out[key] = { t: 'a', v: structuredClone(value) }
+            else if(depth > 0 && isPlainObject(value))
+                out[key] = { t: 'o', v: captureFields(value, depth - 1) }
+        }
+        return out
+    }
+
+    const restoreFields = (object, saved) =>
+    {
+        for(const key in saved)
+        {
+            const { t, v } = saved[key]
+            if(t === 'p') object[key] = v
+            else if(t === 'v') object[key].fromArray(v)
+            else if(t === 'a') object[key] = structuredClone(v)
+            else if(t === 'o' && object[key]) restoreFields(object[key], v)
+        }
+    }
+
+    const restoreWorldInPlace = (world, bytes) =>
+    {
+        const RAPIER = game().RAPIER
+        const restored = RAPIER.World.restoreSnapshot(bytes)
+
+        // Composants "simples" : on échange les objets
+        for(const key of [ 'integrationParameters', 'islands', 'broadPhase', 'narrowPhase' ])
+        {
+            const old = world[key]
+            world[key] = restored[key]
+            restored[key] = old
+        }
+
+        // Ensembles référencés par le jeu : on échange uniquement les données internes
+        for(const key of [ 'bodies', 'colliders', 'impulseJoints', 'multibodyJoints' ])
+        {
+            const old = world[key].raw
+            world[key].raw = restored[key].raw
+            restored[key].raw = old
+        }
+        world.bodies.map.forEach(body => { body.rawSet = world.bodies.raw })
+
+        // Index de requêtes reconstruit à neuf (utilisé par les rayons des roues)
+        const oldQuery = world.queryPipeline.raw
+        world.queryPipeline.raw = restored.queryPipeline.raw
+        restored.queryPipeline.raw = oldQuery
+        world.queryPipeline.update(world.colliders)
+
+        restored.free()
+    }
+
+    /**
+     * Capture générique : toutes les valeurs simples atteignables depuis le jeu (nombres, booléens, chaînes,
+     * vecteurs, couleurs, uniforms des shaders, petits tableaux, caméras), sauf l'interface.
+     * Chaque valeur est notée avec une référence vers son objet : la restauration la réécrit à l'identique.
+     */
+    const DEEP_SKIP_TOP = new Set([ 'audio', 'notifications', 'modals', 'menu', 'achievements', 'server', 'debug', 'rendering',
+        'resourcesLoader', 'resources', 'viewport', 'quality', 'rayCursor', 'map', 'title', 'closingManager', 'konamiCode',
+        'monitoring', 'tabs', 'reveal', 'overlay', 'RAPIER', 'scene', 'domElement', 'canvasElement', 'physics', 'inputs', 'options' ])
+    const DEEP_SKIP_KEY = new Set([ 'game', 'events', 'callbacks', 'waits', 'parent', 'children', 'domElement', 'element', 'renderer' ])
+    const deepSkip = (o) =>
+        (typeof Node !== 'undefined' && o instanceof Node) || o === window ||
+        (o.isObject3D && !o.isCamera) || o.isMaterial || o.isBufferGeometry || o.isBufferAttribute || o.isInterleavedBuffer || o.isTexture || o.isRenderTarget ||
+        o.rawSet !== undefined || o.colliderSet !== undefined || (o.raw !== undefined && typeof o.free === 'function') ||
+        o._howls !== undefined || o._sounds !== undefined || (o.vars !== undefined && o._dur !== undefined) || o instanceof Set || o instanceof WeakMap ||
+        (ArrayBuffer.isView(o) && o.length > 256) || o instanceof ArrayBuffer || o instanceof Promise
+
+    const collectEntries = () =>
+    {
+        const entries = []
+        const seen = new Set()
+        const visit = (object, depth) =>
+        {
+            if(!object || typeof object !== 'object' || seen.has(object) || depth > 9) return
+            seen.add(object)
+            if(deepSkip(object)) return
+            if(object.isCamera)
+            {
+                for(const key of [ 'position', 'quaternion', 'rotation', 'scale', 'up' ]) entries.push([ object[key], null, 'v', object[key].toArray() ])
+                for(const key of [ 'zoom', 'fov', 'aspect', 'near', 'far' ]) if(typeof object[key] === 'number') entries.push([ object, key, 'p', object[key] ])
+                return
+            }
+            if(object instanceof Map) { for(const value of object.values()) visit(value, depth + 1); return }
+            if(ArrayBuffer.isView(object)) { entries.push([ object, null, 't', object.slice() ]); return }
+            for(const key of Object.keys(object))
+            {
+                if(DEEP_SKIP_KEY.has(key) || (depth === 0 && DEEP_SKIP_TOP.has(key))) continue
+                let value
+                try { value = object[key] } catch(e) { continue }
+                const type = typeof value
+                if(value === null || type === 'number' || type === 'boolean' || type === 'string')
+                    entries.push([ object, key, 'p', value ])
+                else if(type === 'object')
+                {
+                    if(isVector(value) || value.isColor || value.isMatrix3 || value.isMatrix4) { if(!seen.has(value)) { seen.add(value); entries.push([ value, null, 'v', value.toArray() ]) } }
+                    else if(value.isNode && 'value' in value)
+                    {
+                        const v = value.value
+                        if(typeof v === 'number' || typeof v === 'boolean') entries.push([ value, 'value', 'p', v ])
+                        else if(v && (isVector(v) || v.isColor || v.isMatrix3 || v.isMatrix4) && !seen.has(v)) { seen.add(v); entries.push([ v, null, 'v', v.toArray() ]) }
+                    }
+                    else if(isPlainArray(value)) entries.push([ object, key, 'a', structuredClone(value) ])
+                    else visit(value, depth + 1)
+                }
+            }
+        }
+        visit(game(), 0)
+        return entries
+    }
+
+    let deepSchema = null
+    tas.resetDeepSchema = () => { deepSchema = null }
+    const SKIP = Symbol('skip')
+    const deepCapture = () =>
+    {
+        if(!deepSchema)
+        {
+            const entries = collectEntries()
+            deepSchema = entries.map(([ object, key, kind ]) => [ object, key, kind ])
+            return { schema: deepSchema, values: entries.map(entry => entry[3]) }
+        }
+        const values = new Array(deepSchema.length)
+        for(let i = 0; i < deepSchema.length; i++)
+        {
+            const [ object, key, kind ] = deepSchema[i]
+            if(kind === 'p') { const v = object[key]; values[i] = (v !== null && typeof v === 'object') ? SKIP : v }
+            else if(kind === 'v') values[i] = object.toArray()
+            else if(kind === 'a') values[i] = isPlainArray(object[key]) ? structuredClone(object[key]) : SKIP
+            else values[i] = object.slice()
+        }
+        return { schema: deepSchema, values }
+    }
+
+    const deepRestore = ({ schema, values }) =>
+    {
+        for(let i = 0; i < schema.length; i++)
+        {
+            const [ object, key, kind ] = schema[i]
+            const value = values[i]
+            if(value === SKIP) continue
+            if(kind === 'p')
+            {
+                // Prudence : on n'écrase jamais un objet créé depuis par une valeur simple
+                const current = object[key]
+                if(current !== null && typeof current === 'object') continue
+                object[key] = value
+            }
+            else if(kind === 'v') object.fromArray(value)
+            else if(kind === 'a') object[key] = structuredClone(value)
+            else if(kind === 't') object.set(value)
+        }
+    }
+    tas.deepCapture = deepCapture
+
+    tas.isSafeFrame = () =>
+    {
+        const g = game()
+        const circuit = g.world.areas.circuit
+        // Délai de redressement réellement en attente (le jeu l'annule sans le remettre à null)
+        const delay = g.player.unstuck.delay
+        const unstuckPending = !!(delay && delay.parent && delay.progress() < 1)
+        const racing = g.player.state === g.player.constructor.STATE_DEFAULT && !g.physicalVehicle.upsideDown.active && !unstuckPending
+        // Juste avant le départ : seul le départ (piloté par le TAS) est en attente
+        const preStart = !!tas.pendingStart && g.player.state !== g.player.constructor.STATE_DEFAULT
+        return circuit.state === 3 && (racing || preStart)
+    }
+
+    tas.saveState = () =>
+    {
+        const g = game()
+        const circuit = g.world.areas.circuit
+        const vehicle = g.physicalVehicle
+        const checkpoints = circuit.checkpoints
+
+        return {
+            frame: tas.frame,
+            raceStartFrame: tas.raceStartFrame,
+            safe: tas.isSafeFrame(),
+            physics: g.physics.world.takeSnapshot(),
+            deep: deepCapture(),
+            rng: gameRandom.state(),
+            timers: [ ...timers.values() ].map(t => ({ ...t })),
+            gsapChildren: new Set(gsap.globalTimeline.getChildren(false, true, true)),
+            ticker: captureFields(g.ticker, 1, [ 'events', 'waits' ]),
+            tickerWaits: g.ticker.waits.map(w => [ ...w ]),
+            time: captureFields(g.time, 2),
+            vehicle: captureFields(vehicle, 2, [ 'wheels' ]),
+            wheels: {
+                inContactCount: vehicle.wheels.inContactCount,
+                justTouchedCount: vehicle.wheels.justTouchedCount,
+                items: vehicle.wheels.items.map(w => captureFields(w, 1))
+            },
+            player: captureFields(g.player, 1),
+            view: captureFields(g.view, 2),
+            objects: {
+                rounded: { ...g.objects.roundedViewPosition },
+                flags: [ ...g.objects.list.values() ].map(o => [ o.needsUpdate, o.reseting ])
+            },
+            circuit: {
+                state: circuit.state,
+                timer: captureFields(circuit.timer, 0),
+                isOut: circuit.bounds.isOut,
+                reachedCount: checkpoints.reachedCount,
+                timings: checkpoints.timings.slice(),
+                target: checkpoints.target ? checkpoints.target.index : null,
+                last: checkpoints.last ? checkpoints.last.index : null
+            },
+            input: tas.input,
+            pendingStart: tas.pendingStart ? { ...tas.pendingStart } : null
+        }
+    }
+
+    tas.loadState = (s) =>
+    {
+        const g = game()
+        const circuit = g.world.areas.circuit
+        const vehicle = g.physicalVehicle
+        const checkpoints = circuit.checkpoints
+
+        // gsap : annuler tout ce qui a été créé après le savestate, puis remettre l'horloge
+        for(const child of gsap.globalTimeline.getChildren(false, true, true))
+            if(!s.gsapChildren.has(child)) child.kill()
+        if(g.player.unstuck.delay && !s.gsapChildren.has(g.player.unstuck.delay)) g.player.unstuck.delay = null
+
+        tas.frame = s.frame
+        tas.raceStartFrame = s.raceStartFrame
+        virtualMs = tas.frame * 1000 / FPS
+        gsap.updateRoot(virtualMs / 1000)
+
+        // Physique
+        restoreWorldInPlace(g.physics.world, s.physics)
+
+        // Hasard et minuteries
+        gameRandom = seedrandom('', { state: s.rng })
+        timers.clear()
+        for(const t of s.timers) timers.set(t.id, { ...t })
+
+        // Jeu : capture générique d'abord, puis les champs spécifiques
+        deepRestore(s.deep)
+        restoreFields(g.ticker, s.ticker)
+        g.ticker.waits = s.tickerWaits.map(w => [ ...w ])
+        restoreFields(g.time, s.time)
+        g.time.scale = g.time._scale
+        restoreFields(vehicle, s.vehicle)
+        vehicle.wheels.inContactCount = s.wheels.inContactCount
+        vehicle.wheels.justTouchedCount = s.wheels.justTouchedCount
+        vehicle.wheels.items.forEach((w, i) => restoreFields(w, s.wheels.items[i]))
+        restoreFields(g.player, s.player)
+        restoreFields(g.view, s.view)
+        Object.assign(g.objects.roundedViewPosition, s.objects.rounded)
+        ;[ ...g.objects.list.values() ].forEach((o, i) => { if(s.objects.flags[i]) [ o.needsUpdate, o.reseting ] = s.objects.flags[i] })
+
+        circuit.state = s.circuit.state
+        restoreFields(circuit.timer, s.circuit.timer)
+        circuit.bounds.isOut = s.circuit.isOut
+        checkpoints.reachedCount = s.circuit.reachedCount
+        checkpoints.timings = s.circuit.timings.slice()
+        checkpoints.last = s.circuit.last === null ? null : checkpoints.items[s.circuit.last]
+        if(s.circuit.target === null) { checkpoints.target = null; checkpoints.doorTarget.mesh.visible = false }
+        else checkpoints.items[s.circuit.target].setTarget()
+
+        tas.input = s.input
+        tas.pendingStart = s.pendingStart ? { ...s.pendingStart } : null
+
+        // Chrono 3D (sa texture n'est redessinée que quand il tourne)
+        if(circuit.timer.running) circuit.timer.write(timeToRaceString(circuit.timer.elapsedTime))
+        else if(circuit.state === 3) circuit.timer.write('00:00:000')
+
+        // Visuel : objets recalés sur la physique
+        g.objects.list.forEach(o => { if(o.physical) o.needsUpdate = true })
+    }
+
+    /**
+     * Installation une fois le jeu chargé
+     */
+    tas.install = () =>
+    {
+        const g = game()
+        if(tas.installed) return
+        tas.installed = true
+
+        // Rendu facultatif
+        const originalRender = g.rendering.render.bind(g.rendering)
+        g.rendering.render = () => { if(tas.render) return originalRender() }
+        tas.renderOriginal = originalRender
+
+        // Départ : le compte à rebours du jeu (gsap) reste visible, mais c'est le TAS qui déclenche
+        // le départ, à une image exacte (3 × 2 s à vitesse ×2 = 3 s = 180 images)
+        const circuit = g.world.areas.circuit
+        const originalStartAnimation = circuit.startAnimation.start
+        circuit.startAnimation.start = (endCallback) =>
+        {
+            originalStartAnimation(null)
+            const seconds = circuit.startAnimation.interDuration * 3 / g.time.defaultScale
+            tas.pendingStart = { frame: tas.frame + Math.round(seconds * FPS), callback: endCallback }
+        }
+
+        // Isolation des entrées : en mode TAS, le jeu ne reçoit plus aucun événement clavier/souris/manette.
+        // (Sinon les effets annexes des touches — sons tirés au hasard, événements — rendraient
+        // l'enregistrement différent de la relecture.) Les touches sont lues ici et traduites en entrées du movie.
+        g.inputs.update = () => {}
+        const isEditorElement = (target) => target && target.closest && target.closest('.tas, .tas-help')
+        const isTextInput = (target) => target && target.matches && target.matches('input:not([type=range]), textarea, [contenteditable]')
+        window.addEventListener('keydown', (event) =>
+        {
+            if(tas.onKeyDown && tas.onKeyDown(event)) { event.preventDefault(); event.stopImmediatePropagation(); return }
+            if(isTextInput(event.target)) return
+            tas.keys.add(event.code)
+            if(/^(Arrow|Space|Page|Home|End|Tab)/.test(event.code) || event.code.startsWith('Numpad')) event.preventDefault()
+            event.stopImmediatePropagation()
+        }, true)
+        window.addEventListener('keyup', (event) =>
+        {
+            tas.keys.delete(event.code)
+            if(!isTextInput(event.target)) event.stopImmediatePropagation()
+        }, true)
+        window.addEventListener('blur', () => tas.keys.clear())
+        for(const type of [ 'mousedown', 'mousemove', 'mouseup', 'pointerdown', 'pointermove', 'pointerup', 'wheel', 'touchstart', 'touchmove', 'touchend', 'contextmenu', 'click', 'dblclick' ])
+            window.addEventListener(type, (event) =>
+            {
+                if(isEditorElement(event.target)) return
+                if(type === 'mouseup' && tas.onMouseUpOutside) tas.onMouseUpOutside()
+                event.stopImmediatePropagation()
+            }, true)
+
+        // Sons : leur déclenchement dépend de l'état du lecteur audio (déblocage, anti-répétition…), pas de la course.
+        // Leurs tirages au hasard (hauteur, choix du son) utilisent donc une source à part.
+        const isolateRandom = (fn) => function(...args)
+        {
+            const previous = Math.random
+            Math.random = outsideRandom
+            try { return fn.apply(this, args) }
+            finally { Math.random = previous }
+        }
+        const wrapItem = (item) => { if(item && typeof item.play === 'function' && !item.play.__tas) { item.play = isolateRandom(item.play); item.play.__tas = true } return item }
+        const wrapGroups = () => g.audio.groups.forEach(group =>
+        {
+            group.items.forEach(wrapItem)
+            for(const key of [ 'play', 'playRandomNext' ])
+                if(typeof group[key] === 'function' && !group[key].__tas) { group[key] = isolateRandom(group[key]); group[key].__tas = true }
+        })
+        wrapGroups()
+        const originalRegister = g.audio.register.bind(g.audio)
+        g.audio.register = (options) => { const item = originalRegister(options); wrapGroups(); return item }
+
+        // Correspondance touches → actions, reprise de la configuration du jeu
+        const codesOf = (name) => (g.inputs.actions.get(name)?.keys || []).filter(k => k.startsWith('Keyboard.')).map(k => k.slice(9))
+        tas.keyMap = {}
+        for(const name of [ 'forward', 'backward', 'left', 'right', 'boost', 'brake', 'suspensions', 'suspensionsFront', 'suspensionsBack', 'suspensionsRight', 'suspensionsLeft', 'suspensionsFrontLeft', 'suspensionsFrontRight', 'suspensionsBackRight', 'suspensionsBackLeft' ])
+            tas.keyMap[name] = codesOf(name)
+
+        // Entrées : on laisse Player calculer (verrouillage, etc.) puis on impose le movie
+        const originalPre = g.player.updatePrePhysics.bind(g.player)
+        g.player.updatePrePhysics = () =>
+        {
+            originalPre()
+
+            // Enregistrement : on capture les entrées réelles (clavier/manette) et on les rejoue
+            // par le même chemin que la lecture, pour que movie et run soient identiques
+            if(tas.captureLive)
+            {
+                const p = g.player
+                tas.captured = p.state === p.constructor.STATE_DEFAULT ? tas.liveInput() : null
+                tas.input = tas.captured
+            }
+
+            const input = tas.input
+            if(!input || g.player.state !== g.player.constructor.STATE_DEFAULT) return
+            g.player.accelerating = input.throttle ?? 0
+            g.player.steering = input.steer ?? 0
+            g.player.boosting = input.boost ? 1 : 0
+            g.player.braking = input.brake ? 1 : 0
+            if(g.player.braking) g.player.accelerating = 0
+            if(input.susp)
+                g.player.suspensions = input.susp.slice()
+            else
+                g.player.suspensions = input.jump ? [ 'high', 'high', 'high', 'high' ] : [ 'low', 'low', 'low', 'low' ]
+        }
+    }
+
+    /**
+     * Passe l'intro, lance la course et s'arrête juste avant l'image du départ (image 0 du movie)
+     */
+    tas.startRace = () =>
+    {
+        const g = game()
+        tas.install()
+        tas.input = null
+        // Intro (avec "#skip" dans l'URL, elle s'enchaîne toute seule)
+        if(!tas.stepUntil(() => g.reveal.step >= 2, 60 * 60))
+            throw new Error('Intro non terminée : ajoutez "&skip" à l\'URL')
+        // Course
+        const circuit = g.world.areas.circuit
+        tas.pendingStart = null
+        circuit.restart()
+        // On s'arrête juste avant l'image du départ : l'image 0 du movie est celle où le chrono démarre
+        tas.stepUntil(() => tas.pendingStart && tas.frame + 1 >= tas.pendingStart.frame, 60 * 30)
+        tas.raceStartFrame = tas.frame
+        tas.resetDeepSchema()
+        return tas.state()
+    }
+
+    /**
+     * Joue un movie (tableau d'entrées, une par image) depuis le départ de la course
+     * Renvoie le résultat et, si demandé, la trajectoire complète
+     */
+    tas.playMovie = (movie, { record = true, stopAtFinish = true } = {}) =>
+    {
+        const circuit = game().world.areas.circuit
+        tas.log = record ? [ tas.state() ] : null
+        let finishFrame = null
+        for(let i = 0; i < movie.length; i++)
+        {
+            tas.input = movie[i]
+            tas.step()
+            if(finishFrame === null && circuit.state !== 3 && circuit.checkpoints.reachedCount >= circuit.checkpoints.count + 2)
+            {
+                finishFrame = i + 1
+                if(stopAtFinish) break
+            }
+        }
+        tas.input = null
+        const log = tas.log
+        tas.log = null
+        return {
+            finished: finishFrame !== null,
+            finishFrame,
+            time: finishFrame !== null ? circuit.timer.elapsedTime : null,
+            reached: circuit.checkpoints.reachedCount,
+            timings: circuit.checkpoints.timings.slice(),
+            final: tas.state(),
+            log
+        }
+    }
+
+    /**
+     * Éditeur (si "#tas&editor") : démarre dès que le jeu est chargé
+     */
+    if(tas.editorRequested)
+    {
+        const waitForGame = tas.real.setInterval(() =>
+        {
+            if(!window.game?.overlay) return
+            tas.real.clearInterval(waitForGame)
+            tas.real.setTimeout(() =>
+            {
+                tas.editor = new TasEditor(tas)
+                window.addEventListener('resize', () => tas.real.setTimeout(() => tas.renderOriginal && tas.renderOriginal(), 400))
+            }, 0)
+        }, 50)
+    }
+}

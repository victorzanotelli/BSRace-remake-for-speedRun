@@ -0,0 +1,1255 @@
+/**
+ * Éditeur TAS intégré au jeu (mode "#tas&editor")
+ *
+ * - image 0 = l'image du départ : le chrono démarre à cette image et l'entrée 0 s'y applique
+ * - "image courante" = prochaine image à jouer : l'état affiché est celui obtenu après les images 0 … courante-1,
+ *   le chrono vaut donc courante / 60 (00:00.000 à l'image 0)
+ * - greenzone : savestates automatiques toutes les GREEN_INTERVAL images pour revenir en arrière instantanément,
+ *   plus un petit cache de savestates rapprochés autour du curseur pour rembobiner image par image en douceur
+ */
+import { Howler } from 'howler'
+
+const GREEN_INTERVAL = 20
+const GREEN_MAX = 300
+const ROWS_BEFORE = 10
+const ROWS_AFTER = 22
+const SPEEDS = [ 0.05, 0.1, 0.25, 0.5, 1, 2, 4 ]
+const NEUTRAL = Object.freeze({ throttle: 0, steer: 0, boost: false, brake: false, susp: null })
+const STORAGE_KEY = 'bs-tas-autosave'
+const SETTINGS_KEY = 'bs-tas-settings'
+const FINE_INTERVAL = 5
+const FINE_MAX = 12
+
+// Actions de l'éditeur et raccourcis par défaut. Les lettres sont reconnues par leur caractère
+// (Ctrl+Z reste Ctrl+Z en AZERTY), les autres touches par leur position (code).
+const EDITOR_ACTIONS = [
+    [ 'help', 'Aide', { code: 'F1' } ],
+    [ 'play', 'Lecture / pause', { code: 'F2' } ],
+    [ 'back', 'Image précédente (maintenir : rembobiner)', { code: 'F3' } ],
+    [ 'next', 'Image suivante (maintenir : avancer)', { code: 'F4' } ],
+    [ 'rec', 'Enregistrement ON/OFF', { code: 'F5' } ],
+    [ 'start', 'Retour au départ (image 0)', { code: 'F6' } ],
+    [ 'slower', 'Ralentir la lecture', { code: 'F7' } ],
+    [ 'faster', 'Accélérer la lecture', { code: 'F8' } ],
+    [ 'settings', 'Réglages', { code: 'F10' } ],
+    [ 'undo', 'Annuler', { code: 'KeyZ', key: 'z', ctrl: true } ],
+    [ 'redo', 'Rétablir', { code: 'KeyY', key: 'y', ctrl: true } ],
+    [ 'save', 'Enregistrer le movie', { code: 'KeyS', key: 's', ctrl: true } ],
+    [ 'open', 'Ouvrir un movie', { code: 'KeyO', key: 'o', ctrl: true } ],
+    [ 'insert', 'Insérer une image neutre', { code: 'Insert' } ],
+    [ 'delete', 'Supprimer l\'image courante', { code: 'Delete' } ]
+]
+const NO_REPEAT = new Set([ 'help', 'play', 'rec', 'start', 'settings', 'save', 'open' ])
+const DRIVING_ACTIONS = [
+    [ 'forward', 'Avancer' ], [ 'backward', 'Reculer' ], [ 'left', 'Gauche' ], [ 'right', 'Droite' ],
+    [ 'boost', 'Boost' ], [ 'brake', 'Frein' ], [ 'suspensions', 'Saut' ]
+]
+const KEY_NAMES = {
+    ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→', Space: 'Espace', ShiftLeft: 'Maj gauche', ShiftRight: 'Maj droite',
+    ControlLeft: 'Ctrl gauche', ControlRight: 'Ctrl droite', AltLeft: 'Alt', AltRight: 'Alt Gr', Insert: 'Inser', Delete: 'Suppr',
+    Enter: 'Entrée', Backspace: 'Retour arrière', Tab: 'Tab', Escape: 'Échap', PageUp: 'Pg préc', PageDown: 'Pg suiv', Home: 'Début', End: 'Fin'
+}
+
+const formatTime = (seconds) =>
+{
+    if(seconds === null || seconds === undefined || !isFinite(seconds)) return '--:--.---'
+    const ms = Math.floor(seconds * 1000 + 1e-6)
+    const m = Math.floor(ms / 60000)
+    const s = Math.floor(ms / 1000) % 60
+    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${String(ms % 1000).padStart(3, '0')}`
+}
+
+const sameInput = (a, b) =>
+    a.throttle === b.throttle && a.steer === b.steer && !!a.boost === !!b.boost && !!a.brake === !!b.brake &&
+    (a.susp ? a.susp.join() : '') === (b.susp ? b.susp.join() : '')
+
+const isAllLow = (susp) => !susp || susp.every(s => s === 'low')
+const JUMP = [ 'high', 'high', 'high', 'high' ]
+
+export class TasEditor
+{
+    constructor(tas)
+    {
+        this.tas = tas
+        this.game = window.game
+        this.circuit = this.game.world.areas.circuit
+
+        this.movie = []
+        this.greenzone = new Map()
+        this.playing = false
+        this.recording = false
+        this.speedIndex = SPEEDS.indexOf(1)
+        this.accumulator = 0
+        this.finish = null
+        this.dirty = false
+        this.paint = null
+        this.history = []
+        this.historyIndex = -1
+        this.fineCache = new Map()
+        this.countdown = null
+        this.capture = null
+
+        this.tas.install()
+        this.loadSettings()
+        this.disableGameShortcuts()
+        this.setStyle()
+        this.setDom()
+        this.start()
+        this.restoreAutosave()
+        this.setKeyboard()
+        this.loop = this.loop.bind(this)
+        this.lastTime = performance.now()
+        requestAnimationFrame(this.loop)
+
+        this.tas.real.setInterval(() => this.autosave(), 5000)
+        window.addEventListener('beforeunload', () => this.autosave())
+    }
+
+    /**
+     * Jeu
+     */
+    disableGameShortcuts()
+    {
+        // R (recommencer / respawn) : géré par l'éditeur
+        this.game.inputs.events.off('circuitRestart')
+        this.game.inputs.events.off('respawn')
+    }
+
+    get current()
+    {
+        return this.tas.frame - this.tas.raceStartFrame
+    }
+
+    inputAt(index)
+    {
+        return this.movie[index] || NEUTRAL
+    }
+
+    toTasInput(input)
+    {
+        return {
+            throttle: input.throttle,
+            steer: input.steer,
+            boost: !!input.boost,
+            brake: !!input.brake,
+            susp: input.susp ? input.susp.slice() : null
+        }
+    }
+
+    silent(callback)
+    {
+        Howler.mute(true)
+        const previousRender = this.tas.render
+        this.tas.render = false
+        try { callback() }
+        finally
+        {
+            this.tas.render = previousRender
+            Howler.mute(this.game.audio.mute.active)
+        }
+    }
+
+    renderNow()
+    {
+        this.tas.renderOriginal()
+    }
+
+    start()
+    {
+        this.silent(() => this.tas.startRace())
+        this.greenzone.set(0, this.tas.saveState())
+        this.renderNow()
+    }
+
+    /**
+     * Avance d'une image (lecture ou enregistrement)
+     */
+    stepOne(render)
+    {
+        const index = this.current
+
+        if(this.recording)
+        {
+            this.tas.captureLive = true
+            this.tas.input = null
+        }
+        else
+        {
+            if(index >= this.movie.length)
+                this.extendMovie(index + 1)
+            this.tas.input = this.toTasInput(this.inputAt(index))
+        }
+
+        this.tas.render = render
+        this.tas.step()
+        this.tas.render = false
+
+        if(this.recording)
+        {
+            this.tas.captureLive = false
+            const captured = this.tas.captured ? this.fromTasInput(this.tas.captured) : { ...NEUTRAL }
+            if(index >= this.movie.length) this.extendMovie(index)
+            if(!this.movie[index] || !sameInput(this.movie[index], captured))
+            {
+                this.pushHistory([ index ])
+                this.movie[index] = captured
+                this.invalidateAfter(index)
+                this.dirty = true
+            }
+        }
+
+        // Greenzone
+        const after = this.current
+        if(after % GREEN_INTERVAL === 0 && !this.greenzone.has(after) && this.tas.isSafeFrame())
+        {
+            this.greenzone.set(after, this.tas.saveState())
+            this.trimGreenzone()
+        }
+
+        // Arrivée
+        if(!this.finish && this.circuit.checkpoints.reachedCount >= this.circuit.checkpoints.count + 2)
+        {
+            this.finish = { frame: after, time: this.circuit.timer.elapsedTime, timings: this.circuit.checkpoints.timings.slice() }
+            this.playing = false
+            this.flash(`Arrivée : ${formatTime(this.finish.time)} (image ${after})`)
+        }
+    }
+
+    fromTasInput(input)
+    {
+        return {
+            throttle: input.throttle || 0,
+            steer: input.steer || 0,
+            boost: !!input.boost,
+            brake: !!input.brake,
+            susp: isAllLow(input.susp) ? null : input.susp.slice()
+        }
+    }
+
+    extendMovie(length)
+    {
+        while(this.movie.length < length)
+            this.movie.push({ ...NEUTRAL })
+    }
+
+    trimGreenzone()
+    {
+        if(this.greenzone.size <= GREEN_MAX) return
+        const current = this.current
+        const keys = [ ...this.greenzone.keys() ].filter(k => k !== 0).sort((a, b) => Math.abs(b - current) - Math.abs(a - current))
+        while(this.greenzone.size > GREEN_MAX)
+            this.greenzone.delete(keys.shift())
+    }
+
+    trimFineCache()
+    {
+        if(this.fineCache.size <= FINE_MAX) return
+        const current = this.current
+        const keys = [ ...this.fineCache.keys() ].sort((a, b) => Math.abs(b - current) - Math.abs(a - current))
+        while(this.fineCache.size > FINE_MAX) this.fineCache.delete(keys.shift())
+    }
+
+    invalidateAfter(index)
+    {
+        for(const key of [ ...this.greenzone.keys() ])
+            if(key > index) this.greenzone.delete(key)
+        for(const key of [ ...this.fineCache.keys() ])
+            if(key > index) this.fineCache.delete(key)
+        if(this.finish && this.finish.frame > index) this.finish = null
+    }
+
+    /**
+     * Aller à une image (restaure le savestate le plus proche puis rejoue sans affichage)
+     */
+    seek(target, { force = false, render = true } = {})
+    {
+        target = Math.max(0, Math.round(target))
+        const current = this.current
+        if(target === current && !force) return
+
+        const wasRecording = this.recording
+        this.recording = false
+
+        this.silent(() =>
+        {
+            // Point de départ : savestate le plus proche avant la cible (une image avant si possible, pour l'affichage)
+            const limit = target > 0 ? target - 1 : 0
+            let best = 0, bestState = this.greenzone.get(0)
+            for(const [ key, state ] of this.greenzone)
+                if(key <= limit && key > best) { best = key; bestState = state }
+            for(const [ key, state ] of this.fineCache)
+                if(key <= limit && key > best) { best = key; bestState = state }
+
+            const canContinue = !force && target > current && current >= best
+            if(!canContinue)
+                this.tas.loadState(bestState)
+
+            // En rejouant, on garde des savestates rapprochés juste avant la cible : le prochain retour
+            // d'une image n'aura presque rien à recalculer
+            while(this.current < target)
+            {
+                this.stepOne(false)
+                const index = this.current
+                if(index < target && index > target - FINE_INTERVAL * 5 && index % FINE_INTERVAL === 0 && !this.greenzone.has(index) && !this.fineCache.has(index) && this.tas.isSafeFrame())
+                    this.fineCache.set(index, this.tas.saveState())
+            }
+            this.trimFineCache()
+        })
+
+        this.recording = wasRecording
+        if(render) this.renderNow()
+    }
+
+    resync(fromIndex)
+    {
+        this.invalidateAfter(fromIndex)
+        if(this.current > fromIndex)
+            this.seek(this.current, { force: true })
+    }
+
+    /**
+     * Édition
+     */
+    pushHistory(indices)
+    {
+        const entry = indices.map(i => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history.length = this.historyIndex + 1
+        this.history.push({ entry, length: this.movie.length })
+        if(this.history.length > 500) this.history.shift()
+        this.historyIndex = this.history.length - 1
+    }
+
+    undo()
+    {
+        if(this.historyIndex < 0) return
+        const { entry, length } = this.history[this.historyIndex]
+        const redo = entry.map(([ i ]) => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history[this.historyIndex] = { entry: redo, length: this.movie.length, undone: true }
+        this.historyIndex--
+        let min = Infinity
+        for(const [ i, value ] of entry)
+        {
+            min = Math.min(min, i)
+            if(value) this.movie[i] = value
+        }
+        this.movie.length = Math.max(length, 0)
+        this.extendMovie(length)
+        this.dirty = true
+        this.resync(isFinite(min) ? min : 0)
+        this.flash('Annulé')
+    }
+
+    redo()
+    {
+        if(this.historyIndex >= this.history.length - 1) return
+        this.historyIndex++
+        const { entry, length } = this.history[this.historyIndex]
+        const back = entry.map(([ i ]) => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history[this.historyIndex] = { entry: back, length: this.movie.length }
+        let min = Infinity
+        for(const [ i, value ] of entry)
+        {
+            min = Math.min(min, i)
+            if(value) this.movie[i] = value
+        }
+        this.movie.length = length
+        this.extendMovie(length)
+        this.dirty = true
+        this.resync(isFinite(min) ? min : 0)
+        this.flash('Rétabli')
+    }
+
+    setInputs(indices, patch, { resync = true } = {})
+    {
+        if(!indices.length) return
+        const max = Math.max(...indices)
+        this.extendMovie(max + 1)
+        this.pushHistory(indices)
+        for(const i of indices)
+            this.movie[i] = { ...this.movie[i], ...(typeof patch === 'function' ? patch(this.movie[i], i) : patch) }
+        this.dirty = true
+        if(resync) this.resync(Math.min(...indices))
+    }
+
+    insertFrame()
+    {
+        const index = this.current
+        this.pushHistory(Array.from({ length: Math.max(0, this.movie.length - index + 1) }, (_, k) => index + k))
+        this.movie.splice(index, 0, { ...NEUTRAL })
+        this.dirty = true
+        this.resync(index)
+        this.flash(`Image insérée à ${index}`)
+    }
+
+    deleteFrame()
+    {
+        const index = this.current
+        if(index >= this.movie.length) return
+        this.pushHistory(Array.from({ length: this.movie.length - index }, (_, k) => index + k))
+        this.movie.splice(index, 1)
+        this.dirty = true
+        this.resync(index)
+        this.flash(`Image ${index} supprimée`)
+    }
+
+    truncate()
+    {
+        const index = this.current
+        if(index >= this.movie.length) return
+        this.pushHistory(Array.from({ length: this.movie.length - index }, (_, k) => index + k))
+        this.movie.length = index
+        this.dirty = true
+        this.invalidateAfter(index)
+        this.flash(`Movie coupé après l'image ${index - 1}`)
+    }
+
+    /**
+     * Fichiers
+     */
+    serialize()
+    {
+        return {
+            format: 'bs-folio-tas-movie',
+            version: 2, // v2 : l'image 0 est l'image du départ (v1 : l'image suivante)
+            game: 'brunosimon/folio-2025',
+            fps: this.tas.fps,
+            result: this.finish ? { frames: this.finish.frame, time: this.finish.time, timings: this.finish.timings } : null,
+            inputs: this.movie.map(i => [ i.throttle, i.steer, i.boost ? 1 : 0, i.brake ? 1 : 0, i.susp ? i.susp.map(s => s[0]).join('') : '' ])
+        }
+    }
+
+    deserialize(data)
+    {
+        if(!data || data.format !== 'bs-folio-tas-movie' || !Array.isArray(data.inputs))
+            throw new Error('Fichier non reconnu (format bs-folio-tas-movie attendu)')
+        const map = { l: 'low', m: 'mid', h: 'high' }
+        const movie = data.inputs.map(([ throttle, steer, boost, brake, susp ]) => ({
+            throttle: +throttle || 0,
+            steer: +steer || 0,
+            boost: !!boost,
+            brake: !!brake,
+            susp: susp && susp !== 'llll' ? [ ...susp ].map(c => map[c] || 'low') : null
+        }))
+        // Movies v1 (éditeur 1.1.0) : leur image 0 tombait une image après le départ
+        if((data.version || 1) < 2) movie.unshift({ ...NEUTRAL })
+        return movie
+    }
+
+    loadMovie(movie, label)
+    {
+        this.movie = movie
+        this.history = []
+        this.historyIndex = -1
+        this.finish = null
+        this.playing = false
+        this.recording = false
+        this.dirty = false
+        this.invalidateAfter(0)
+        this.seek(0, { force: true })
+        if(label) this.flash(label)
+    }
+
+    saveFile()
+    {
+        const blob = new Blob([ JSON.stringify(this.serialize()) ], { type: 'application/json' })
+        const link = document.createElement('a')
+        const time = this.finish ? '-' + formatTime(this.finish.time).replace(/[:.]/g, '') : ''
+        link.href = URL.createObjectURL(blob)
+        link.download = `bs-tas${time}.json`
+        link.click()
+        this.tas.real.setTimeout(() => URL.revokeObjectURL(link.href), 1000)
+        this.flash('Movie enregistré')
+    }
+
+    openFile()
+    {
+        this.dom.file.value = ''
+        this.dom.file.click()
+    }
+
+    autosave()
+    {
+        if(!this.dirty) return
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(this.serialize())); this.dirty = false } catch(e) {}
+    }
+
+    restoreAutosave()
+    {
+        try
+        {
+            const raw = localStorage.getItem(STORAGE_KEY)
+            if(!raw) return
+            const movie = this.deserialize(JSON.parse(raw))
+            if(movie.length)
+            {
+                this.movie = movie
+                this.flash(`Movie précédent restauré (${movie.length} images)`)
+            }
+        }
+        catch(e) {}
+    }
+
+    /**
+     * Boucle temps réel
+     */
+    loop(time)
+    {
+        const delta = Math.min((time - this.lastTime) / 1000, 0.1)
+        this.lastTime = time
+
+        if(this.countdown) this.updateCountdown(performance.now())
+
+        if(this.playing)
+        {
+            this.accumulator += delta * SPEEDS[this.speedIndex]
+            let count = Math.floor(this.accumulator * this.tas.fps)
+            this.accumulator -= count / this.tas.fps
+            count = Math.min(count, 8)
+            if(count > 0)
+            {
+                Howler.mute(this.game.audio.mute.active || SPEEDS[this.speedIndex] !== 1)
+                for(let i = 0; i < count && this.playing; i++)
+                    this.stepOne(i === count - 1)
+            }
+        }
+
+        this.updateDom()
+        requestAnimationFrame(this.loop)
+    }
+
+    togglePlay()
+    {
+        // Pendant le compte à rebours : annule
+        if(this.countdown) { this.stopCountdown(); this.flash('Départ annulé'); return }
+
+        if(this.playing)
+        {
+            this.playing = false
+            this.renderNow()
+            return
+        }
+
+        // Compte à rebours avant de partir en enregistrement, ou depuis l'image 0
+        if(this.settings.countdown > 0 && (this.recording || this.current === 0))
+            this.startCountdown()
+        else
+        {
+            this.playing = true
+            this.accumulator = 0
+        }
+    }
+
+    startCountdown()
+    {
+        const now = performance.now()
+        this.countdown = { end: now + this.settings.countdown * 1000, shown: null }
+        this.dom.countdown.classList.add('is-visible')
+        this.updateCountdown(now)
+    }
+
+    stopCountdown()
+    {
+        this.countdown = null
+        this.dom.countdown.classList.remove('is-visible', 'is-go')
+    }
+
+    updateCountdown(now)
+    {
+        const remaining = (this.countdown.end - now) / 1000
+        if(remaining <= 0)
+        {
+            this.stopCountdown()
+            this.dom.countdown.textContent = 'GO'
+            this.dom.countdown.classList.add('is-visible', 'is-go')
+            this.tas.real.setTimeout(() => { if(!this.countdown) this.dom.countdown.classList.remove('is-visible', 'is-go') }, 600)
+            this.beep(1320, 0.35)
+            this.playing = true
+            this.accumulator = 0
+            return
+        }
+        const shown = Math.ceil(remaining)
+        if(shown !== this.countdown.shown)
+        {
+            this.countdown.shown = shown
+            this.dom.countdown.textContent = shown
+            this.beep(880, 0.12)
+        }
+    }
+
+    beep(frequency, duration)
+    {
+        if(!this.settings.beep) return
+        try
+        {
+            this.audioContext ||= new (window.AudioContext || window.webkitAudioContext)()
+            const context = this.audioContext
+            const oscillator = context.createOscillator()
+            const gain = context.createGain()
+            oscillator.frequency.value = frequency
+            gain.gain.setValueAtTime(0.18, context.currentTime)
+            gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + duration)
+            oscillator.connect(gain).connect(context.destination)
+            oscillator.start()
+            oscillator.stop(context.currentTime + duration)
+        }
+        catch(e) {}
+    }
+
+    frameAdvance()
+    {
+        this.playing = false
+        if(this.countdown) this.stopCountdown()
+        this.stepOne(true)
+    }
+
+    frameBack()
+    {
+        this.playing = false
+        if(this.countdown) this.stopCountdown()
+        if(this.current > 0) this.seek(this.current - 1)
+    }
+
+    goToStart()
+    {
+        this.playing = false
+        if(this.countdown) this.stopCountdown()
+        this.seek(0)
+    }
+
+    toggleRecord()
+    {
+        this.recording = !this.recording
+        this.flash(this.recording ? 'Enregistrement : vos touches remplacent les entrées' : 'Lecture : les entrées du movie sont rejouées')
+    }
+
+    changeSpeed(direction)
+    {
+        this.speedIndex = Math.max(0, Math.min(SPEEDS.length - 1, this.speedIndex + direction))
+        this.flash(`Vitesse ×${SPEEDS[this.speedIndex]}`)
+    }
+
+    /**
+     * Clavier
+     */
+    setKeyboard()
+    {
+        // Appelé par Tas.js avant que la touche soit bloquée pour le jeu ; renvoie true si la touche est pour l'éditeur
+        this.tas.onKeyDown = (event) =>
+        {
+            const target = event.target
+            const typing = target && target.matches && target.matches('input:not([type=range]), textarea')
+
+            // Réglages : on attend une touche à affecter
+            if(this.capture) { this.captureKey(event); return true }
+            if(typing) return false
+
+            // Réglages ouverts : Échap ferme
+            if(this.dom.settings.classList.contains('is-visible') && event.code === 'Escape') { this.toggleSettings(); return true }
+
+            const action = this.matchAction(event)
+            if(!action) return false
+            if(event.repeat && NO_REPEAT.has(action)) return true
+            this.runAction(action, event)
+            return true
+        }
+        this.tas.onMouseUpOutside = () => this.paintEnd()
+    }
+
+    matchesKey(binding, event)
+    {
+        if(!binding) return false
+        if(binding.key && binding.key.length === 1) return event.key && event.key.toLowerCase() === binding.key
+        return event.code === binding.code
+    }
+
+    matchAction(event)
+    {
+        const ctrl = event.ctrlKey || event.metaKey, alt = event.altKey, shift = event.shiftKey
+        const candidates = EDITOR_ACTIONS.map(([ name ]) => [ name, this.settings.bindings[name] ]).filter(([ , b ]) => this.matchesKey(b, event))
+        // D'abord la combinaison exacte, sinon une combinaison dont les modificateurs requis sont enfoncés
+        // (permet par exemple d'avancer d'une image en maintenant Maj pour le boost)
+        const exact = candidates.find(([ , b ]) => !!b.ctrl === ctrl && !!b.alt === alt && !!b.shift === shift)
+        if(exact) return exact[0]
+        const loose = candidates.find(([ , b ]) => (!b.ctrl || ctrl) && (!b.alt || alt) && (!b.shift || shift))
+        if(!loose) return null
+        // Ctrl+Maj+Z : rétablir
+        if(loose[0] === 'undo' && shift) return 'redo'
+        return loose[0]
+    }
+
+    runAction(action)
+    {
+        const actions = {
+            help: () => this.toggleHelp(),
+            play: () => this.togglePlay(),
+            back: () => this.frameBack(),
+            next: () => this.frameAdvance(),
+            rec: () => this.toggleRecord(),
+            start: () => this.goToStart(),
+            slower: () => this.changeSpeed(-1),
+            faster: () => this.changeSpeed(1),
+            settings: () => this.toggleSettings(),
+            undo: () => this.undo(),
+            redo: () => this.redo(),
+            save: () => this.saveFile(),
+            open: () => this.openFile(),
+            insert: () => this.insertFrame(),
+            delete: () => this.deleteFrame()
+        }
+        actions[action]?.()
+    }
+
+    /**
+     * Réglages (raccourcis, touches de conduite, compte à rebours) — enregistrés dans le navigateur
+     */
+    defaultSettings()
+    {
+        const bindings = {}
+        for(const [ name, , binding ] of EDITOR_ACTIONS) bindings[name] = { ...binding }
+        const driving = {}
+        for(const [ name ] of DRIVING_ACTIONS) driving[name] = (this.gameKeyMap?.[name] || []).slice(0, 2)
+        return { bindings, driving, countdown: 3, beep: true }
+    }
+
+    loadSettings()
+    {
+        this.gameKeyMap = Object.fromEntries(Object.entries(this.tas.keyMap || {}).map(([ k, v ]) => [ k, v.slice() ]))
+        const defaults = this.defaultSettings()
+        let saved = null
+        try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || 'null') } catch(e) {}
+        this.settings = {
+            ...defaults,
+            ...(saved || {}),
+            bindings: { ...defaults.bindings, ...(saved?.bindings || {}) },
+            driving: { ...defaults.driving, ...(saved?.driving || {}) }
+        }
+        this.applyDriving()
+    }
+
+    saveSettings()
+    {
+        try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(this.settings)) } catch(e) {}
+        this.applyDriving()
+        this.updateTitles()
+    }
+
+    applyDriving()
+    {
+        // Les touches de conduite ne servent qu'à l'enregistrement : la relecture ne dépend que du movie
+        if(!this.tas.keyMap) return
+        for(const [ name ] of DRIVING_ACTIONS)
+            this.tas.keyMap[name] = (this.settings.driving[name] || []).filter(Boolean)
+    }
+
+    keyLabel(code, key)
+    {
+        if(KEY_NAMES[code]) return KEY_NAMES[code]
+        if(key && key.length === 1 && key !== ' ') return key.toUpperCase()
+        const fromLayout = this.layoutMap?.get(code)
+        if(fromLayout) return fromLayout.toUpperCase()
+        if(code.startsWith('Key')) return code.slice(3)
+        if(code.startsWith('Digit')) return code.slice(5)
+        if(code.startsWith('Numpad')) return 'Pavé ' + code.slice(6)
+        return code
+    }
+
+    bindingLabel(binding)
+    {
+        if(!binding) return '—'
+        return (binding.ctrl ? 'Ctrl+' : '') + (binding.alt ? 'Alt+' : '') + (binding.shift ? 'Maj+' : '') + this.keyLabel(binding.code, binding.key)
+    }
+
+    captureKey(event)
+    {
+        const { type, name, slot } = this.capture
+        if([ 'ShiftLeft', 'ShiftRight', 'ControlLeft', 'ControlRight', 'AltLeft', 'AltRight', 'MetaLeft', 'MetaRight' ].includes(event.code) && type === 'editor')
+            return // modificateur seul : on attend la touche
+        if(event.code === 'Escape') { this.capture = null; this.renderSettings(); return }
+
+        if(type === 'editor')
+        {
+            const binding = { code: event.code, ctrl: event.ctrlKey || event.metaKey, alt: event.altKey, shift: event.shiftKey }
+            if(event.key && event.key.length === 1 && /\p{L}/u.test(event.key)) binding.key = event.key.toLowerCase()
+            // Conflit avec une autre action : l'autre perd sa touche
+            for(const [ other ] of EDITOR_ACTIONS)
+            {
+                const b = this.settings.bindings[other]
+                if(other !== name && b && this.bindingLabel(b) === this.bindingLabel(binding))
+                {
+                    this.settings.bindings[other] = null
+                    this.flash(`« ${EDITOR_ACTIONS.find(a => a[0] === other)[1]} » n'a plus de raccourci`)
+                }
+            }
+            this.settings.bindings[name] = binding
+        }
+        else
+        {
+            const keys = (this.settings.driving[name] || []).slice()
+            keys[slot] = event.code
+            this.settings.driving[name] = keys
+            if(this.settings.driving[name].length > 2) this.settings.driving[name].length = 2
+            this.keyLabels = { ...(this.keyLabels || {}), [event.code]: event.key }
+        }
+        this.capture = null
+        this.saveSettings()
+        this.renderSettings()
+    }
+
+    toggleSettings()
+    {
+        const visible = this.dom.settings.classList.toggle('is-visible')
+        this.capture = null
+        if(visible)
+        {
+            this.playing = false
+            if(this.countdown) this.stopCountdown()
+            this.renderSettings()
+        }
+    }
+
+    renderSettings()
+    {
+        const editorRows = EDITOR_ACTIONS.map(([ name, label ]) =>
+        {
+            const listening = this.capture && this.capture.type === 'editor' && this.capture.name === name
+            return `<tr><td>${label}</td><td><span class="tas-chip${listening ? ' is-listening' : ''}">${listening ? 'Appuyez sur une touche…' : this.bindingLabel(this.settings.bindings[name])}</span></td>` +
+                `<td><button data-set="editor" data-name="${name}">Modifier</button></td></tr>`
+        }).join('')
+        const drivingRows = DRIVING_ACTIONS.map(([ name, label ]) =>
+        {
+            const keys = this.settings.driving[name] || []
+            const chip = (slot) =>
+            {
+                const listening = this.capture && this.capture.type === 'driving' && this.capture.name === name && this.capture.slot === slot
+                const code = keys[slot]
+                return `<span class="tas-chip${listening ? ' is-listening' : ''}" data-set="driving" data-name="${name}" data-slot="${slot}" title="Cliquer pour changer">${listening ? 'Appuyez…' : code ? this.keyLabel(code, this.keyLabels?.[code]) : '+'}</span>` +
+                    (code && !listening ? `<button class="tas-x" data-clear="${name}" data-slot="${slot}" title="Retirer">×</button>` : '')
+            }
+            return `<tr><td>${label}</td><td colspan="2">${chip(0)} ${chip(1)}</td></tr>`
+        }).join('')
+        this.dom.settingsBody.innerHTML = /* html */`
+            <h2>Réglages</h2>
+            <h3>Raccourcis de l'éditeur</h3>
+            <table>${editorRows}</table>
+            <h3>Touches de conduite (enregistrement)</h3>
+            <table>${drivingRows}</table>
+            <h3>Départ</h3>
+            <label>Compte à rebours avant la lecture (en REC ou depuis l'image 0) :
+                <input class="js-countdown" type="number" min="0" max="10" step="1" value="${this.settings.countdown}"> s (0 = aucun)</label><br>
+            <label><input class="js-beep" type="checkbox"${this.settings.beep ? ' checked' : ''}> Bips sonores</label>
+            <div class="tas-settings-actions">
+                <button data-action="reset">Réinitialiser</button>
+                <button data-action="close">Fermer (Échap)</button>
+            </div>
+            <p class="tas-note">F9 (retour au jeu normal), F11 (plein écran) et F12 (console) ne sont pas modifiables.</p>`
+    }
+
+    updateTitles()
+    {
+        for(const button of this.dom.root.querySelectorAll('[data-action-title]'))
+        {
+            const [ name, text ] = button.dataset.actionTitle.split('|')
+            button.title = `${text} (${this.bindingLabel(this.settings.bindings[name])})`
+        }
+    }
+

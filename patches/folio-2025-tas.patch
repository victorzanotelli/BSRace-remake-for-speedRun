diff --git a/sources/Game/Tas.js b/sources/Game/Tas.js
new file mode 100644
index 0000000..014c051
--- /dev/null
+++ b/sources/Game/Tas.js
@@ -0,0 +1,752 @@
+/**
+ * Mode TAS (activé par "#tas" dans l'URL)
+ *
+ * Rend le jeu entièrement déterministe :
+ * - plus de boucle requestAnimationFrame : le jeu n'avance que via tas.step()
+ * - temps virtuel à pas fixe (60 images/s) pour le ticker, gsap et Date.now
+ * - Math.random à graine fixe
+ * - entrées du véhicule lues depuis un "movie" (une entrée par image)
+ *
+ * Doit être importé AVANT Game.js (voir index.js).
+ */
+import gsap from 'gsap'
+import seedrandom from 'seedrandom'
+import { TasEditor } from './TasEditor.js'
+import { timeToRaceString } from './utilities/time.js'
+import { circleIntersectsPolygon } from './utilities/maths.js'
+
+const FPS = 60
+const BASE_DATE = Date.UTC(2026, 0, 15, 12, 0, 0) // date fixe (saison/jour constants)
+
+export const tas = {
+    active: /(^|[#&])tas\b/i.test(location.hash),
+    fps: FPS,
+    frame: 0,            // nombre d'images simulées depuis la prise de contrôle
+    render: false,       // dessiner chaque image (lent, utile pour la vidéo)
+    input: null,         // entrée courante { throttle, steer, boost, brake, jump, susp }
+    raceStartFrame: null,
+    log: null            // tableau optionnel d'états enregistrés
+}
+
+/**
+ * F9 : bascule jeu normal ⟷ éditeur TAS (rechargement complet de la page)
+ */
+window.addEventListener('keydown', (event) =>
+{
+    if(event.code !== 'F9' || event.repeat) return
+    event.preventDefault()
+    const debug = /(^|[#&])debug\b/i.test(location.hash) ? 'debug' : null
+    const toTas = !tas.active
+    const course = (location.hash.match(/(?:^|[#&])course=(\w+)/) || [])[1]
+    const hash = [ debug, toTas ? 'tas&skip&editor' : null, toTas && course ? `course=${course}` : null ].filter(Boolean).join('&')
+    location.href = location.pathname + `?mode=${toTas ? 'tas' : 'play'}` + (hash ? '#' + hash : '')
+}, true)
+if(/(^|[#&])editor\b/i.test(location.hash)) document.title = 'BS Folio Race — éditeur TAS'
+
+if(tas.active)
+{
+    window.__TAS__ = tas
+    window.tas = tas
+    tas.editorRequested = /(^|[#&])editor\b/i.test(location.hash)
+    tas.course = (location.hash.match(/(?:^|[#&])course=(\w+)/) || [])[1] || 'circuit'
+
+    // Hasard reproductible : une source pour le jeu (sauvegardée dans les savestates), une autre pour
+    // tout ce qui s'exécute hors des images (sons, interface) afin de ne pas perturber celle du jeu
+    let gameRandom = seedrandom('bs-folio-tas', { state: true })
+    const outsideRandom = seedrandom('bs-folio-tas-outside')
+    Math.random = gameRandom
+    tas.started = false
+
+    // Temps virtuel
+    let virtualMs = 0
+    Date.now = () => BASE_DATE + virtualMs
+
+    // Minuteries virtuelles : setTimeout/setInterval du jeu se déclenchent en temps virtuel, à l'intérieur
+    // des images (sinon elles s'intercaleraient en temps réel entre les images et rendraient le jeu non reproductible).
+    // Avant la première image, setTimeout reste réel (chargement) ; setInterval est toujours virtuel.
+    tas.real = {
+        setTimeout: window.setTimeout.bind(window),
+        clearTimeout: window.clearTimeout.bind(window),
+        setInterval: window.setInterval.bind(window),
+        clearInterval: window.clearInterval.bind(window)
+    }
+    const timers = new Map()
+    let timerId = 1e9
+    const addTimer = (callback, delay, args, repeat) =>
+    {
+        const id = ++timerId
+        delay = Math.max(0, Number(delay) || 0)
+        timers.set(id, { id, callback, args, time: virtualMs + (repeat ? Math.max(1, delay) : delay), interval: repeat ? Math.max(1, delay) : null })
+        return id
+    }
+    window.setTimeout = (callback, delay, ...args) =>
+    {
+        if(typeof callback !== 'function' || !tas.started) return tas.real.setTimeout(callback, delay, ...args)
+        return addTimer(callback, delay, args, false)
+    }
+    window.setInterval = (callback, delay, ...args) =>
+    {
+        if(typeof callback !== 'function') return tas.real.setInterval(callback, delay, ...args)
+        return addTimer(callback, delay, args, true)
+    }
+    window.clearTimeout = window.clearInterval = (id) =>
+    {
+        if(timers.has(id)) timers.delete(id)
+        else { tas.real.clearTimeout(id); tas.real.clearInterval(id) }
+    }
+    const runTimers = () =>
+    {
+        for(;;)
+        {
+            let next = null
+            for(const timer of timers.values())
+                if(timer.time <= virtualMs && (!next || timer.time < next.time || (timer.time === next.time && timer.id < next.id)))
+                    next = timer
+            if(!next) return
+            if(next.interval) next.time += next.interval
+            else timers.delete(next.id)
+            next.callback(...next.args)
+        }
+    }
+    tas.timers = timers
+
+    // gsap piloté à la main
+    gsap.ticker.remove(gsap.updateRoot)
+    gsap.ticker.lagSmoothing(0)
+    tas.gsap = gsap
+
+    /**
+     * Entrées "en direct" (clavier + manette) pour l'enregistrement, même logique que Player
+     */

@@ -0,0 +1,1307 @@
+/**
+ * Éditeur TAS intégré au jeu (mode "#tas&editor")
+ *
+ * - image 0 = l'image du départ : le chrono démarre à cette image et l'entrée 0 s'y applique
+ * - "image courante" = prochaine image à jouer : l'état affiché est celui obtenu après les images 0 … courante-1,
+ *   le chrono vaut donc courante / 60 (00:00.000 à l'image 0)
+ * - greenzone : savestates automatiques toutes les GREEN_INTERVAL images pour revenir en arrière instantanément,
+ *   plus un petit cache de savestates rapprochés autour du curseur pour rembobiner image par image en douceur
+ */
+import { Howler } from 'howler'
+
+const GREEN_INTERVAL = 20
+const GREEN_MAX = 300
+const ROWS_BEFORE = 10
+const ROWS_AFTER = 22
+const SPEEDS = [ 0.05, 0.1, 0.25, 0.5, 1, 2, 4 ]
+const NEUTRAL = Object.freeze({ throttle: 0, steer: 0, boost: false, brake: false, susp: null })
+const STORAGE_KEY = 'bs-tas-autosave'
+const COURSES = { circuit: 'Circuit', tour: 'Grand tour' }
+// Version du tracé (Grand tour : 1 = 1.3.0 sans barrières, 2 = tracé A avec barrières depuis 1.4.0)
+const TRACKS = { tour: 2 }
+const SETTINGS_KEY = 'bs-tas-settings'
+const FINE_INTERVAL = 5
+const FINE_MAX = 12
+
+// Actions de l'éditeur et raccourcis par défaut. Les lettres sont reconnues par leur caractère
+// (Ctrl+Z reste Ctrl+Z en AZERTY), les autres touches par leur position (code).
+const EDITOR_ACTIONS = [
+    [ 'help', 'Aide', { code: 'F1' } ],
+    [ 'play', 'Lecture / pause', { code: 'F2' } ],
+    [ 'back', 'Image précédente (maintenir : rembobiner)', { code: 'F3' } ],
+    [ 'next', 'Image suivante (maintenir : avancer)', { code: 'F4' } ],
+    [ 'rec', 'Enregistrement ON/OFF', { code: 'F5' } ],
+    [ 'start', 'Retour au départ (image 0)', { code: 'F6' } ],
+    [ 'slower', 'Ralentir la lecture', { code: 'F7' } ],
+    [ 'faster', 'Accélérer la lecture', { code: 'F8' } ],
+    [ 'settings', 'Réglages', { code: 'F10' } ],
+    [ 'undo', 'Annuler', { code: 'KeyZ', key: 'z', ctrl: true } ],
+    [ 'redo', 'Rétablir', { code: 'KeyY', key: 'y', ctrl: true } ],
+    [ 'save', 'Enregistrer le movie', { code: 'KeyS', key: 's', ctrl: true } ],
+    [ 'open', 'Ouvrir un movie', { code: 'KeyO', key: 'o', ctrl: true } ],
+    [ 'insert', 'Insérer une image neutre', { code: 'Insert' } ],
+    [ 'delete', 'Supprimer l\'image courante', { code: 'Delete' } ]
+]
+const NO_REPEAT = new Set([ 'help', 'play', 'rec', 'start', 'settings', 'save', 'open' ])
+const DRIVING_ACTIONS = [
+    [ 'forward', 'Avancer' ], [ 'backward', 'Reculer' ], [ 'left', 'Gauche' ], [ 'right', 'Droite' ],
+    [ 'boost', 'Boost' ], [ 'brake', 'Frein' ], [ 'suspensions', 'Saut' ]
+]
+const KEY_NAMES = {
+    ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→', Space: 'Espace', ShiftLeft: 'Maj gauche', ShiftRight: 'Maj droite',
+    ControlLeft: 'Ctrl gauche', ControlRight: 'Ctrl droite', AltLeft: 'Alt', AltRight: 'Alt Gr', Insert: 'Inser', Delete: 'Suppr',
+    Enter: 'Entrée', Backspace: 'Retour arrière', Tab: 'Tab', Escape: 'Échap', PageUp: 'Pg préc', PageDown: 'Pg suiv', Home: 'Début', End: 'Fin'
+}
+
+const formatTime = (seconds) =>
+{
+    if(seconds === null || seconds === undefined || !isFinite(seconds)) return '--:--.---'
+    const ms = Math.floor(seconds * 1000 + 1e-6)
+    const m = Math.floor(ms / 60000)
+    const s = Math.floor(ms / 1000) % 60
+    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${String(ms % 1000).padStart(3, '0')}`
+}
+
+const sameInput = (a, b) =>
+    a.throttle === b.throttle && a.steer === b.steer && !!a.boost === !!b.boost && !!a.brake === !!b.brake &&
+    (a.susp ? a.susp.join() : '') === (b.susp ? b.susp.join() : '')
+
+const isAllLow = (susp) => !susp || susp.every(s => s === 'low')
+const JUMP = [ 'high', 'high', 'high', 'high' ]
+
+export class TasEditor
+{
+    constructor(tas)
+    {
+        this.tas = tas
+        this.game = window.game
+        this.circuit = this.game.world.areas.circuit
+        this.course = COURSES[tas.course] ? tas.course : 'circuit'
+
+        this.movie = []
+        this.greenzone = new Map()
+        this.playing = false
+        this.recording = false
+        this.speedIndex = SPEEDS.indexOf(1)
+        this.accumulator = 0
+        this.finish = null
+        this.dirty = false
+        this.paint = null
+        this.history = []
+        this.historyIndex = -1
+        this.fineCache = new Map()
+        this.countdown = null
+        this.capture = null
+
+        this.tas.install()
+        this.loadSettings()
+        this.disableGameShortcuts()
+        this.setStyle()
+        this.setDom()
+        this.start()
+        this.restoreAutosave()
+        this.setKeyboard()
+        this.loop = this.loop.bind(this)
+        this.lastTime = performance.now()
+        requestAnimationFrame(this.loop)
+
+        this.tas.real.setInterval(() => this.autosave(), 5000)
+        window.addEventListener('beforeunload', () => this.autosave())
+    }
+
+    /**
+     * Jeu
+     */
+    disableGameShortcuts()
+    {
+        // R (recommencer / respawn) : géré par l'éditeur
+        this.game.inputs.events.off('circuitRestart')
+        this.game.inputs.events.off('respawn')
+    }
+
+    get current()
+    {
+        return this.tas.frame - this.tas.raceStartFrame
+    }
+
+    inputAt(index)
+    {
+        return this.movie[index] || NEUTRAL
+    }
+
+    toTasInput(input)
+    {
+        return {
+            throttle: input.throttle,
+            steer: input.steer,
+            boost: !!input.boost,
+            brake: !!input.brake,
+            susp: input.susp ? input.susp.slice() : null
+        }
+    }
+
+    silent(callback)
+    {
+        Howler.mute(true)
+        const previousRender = this.tas.render
+        this.tas.render = false
+        try { callback() }
+        finally
+        {
+            this.tas.render = previousRender
+            Howler.mute(this.game.audio.mute.active)
+        }
+    }
+
+    renderNow()
+    {
+        this.tas.renderOriginal()
+    }
+
+    start()
+    {
+        this.silent(() => this.tas.startRace(this.course))
+        this.greenzone.set(0, this.tas.saveState())
+        this.renderNow()
+    }
+
+    /**
+     * Avance d'une image (lecture ou enregistrement)
+     */
+    stepOne(render)
+    {
+        const index = this.current
+
+        if(this.recording)
+        {
+            this.tas.captureLive = true
+            this.tas.input = null
+        }
+        else
+        {
+            if(index >= this.movie.length)
+                this.extendMovie(index + 1)
+            this.tas.input = this.toTasInput(this.inputAt(index))
+        }
+
+        this.tas.render = render
+        this.tas.step()
+        this.tas.render = false
+
+        if(this.recording)
+        {
+            this.tas.captureLive = false
+            const captured = this.tas.captured ? this.fromTasInput(this.tas.captured) : { ...NEUTRAL }
+            if(index >= this.movie.length) this.extendMovie(index)
+            if(!this.movie[index] || !sameInput(this.movie[index], captured))
+            {
+                this.pushHistory([ index ])
+                this.movie[index] = captured
+                this.invalidateAfter(index)
+                this.dirty = true
+            }
+        }
+
+        // Greenzone
+        const after = this.current
+        if(after % GREEN_INTERVAL === 0 && !this.greenzone.has(after) && this.tas.isSafeFrame())
+        {
+            this.greenzone.set(after, this.tas.saveState())
+            this.trimGreenzone()
+        }
+
+        // Arrivée
+        if(!this.finish && this.circuit.checkpoints.reachedCount >= this.circuit.checkpoints.count + 2)
+        {
+            this.finish = { frame: after, time: this.circuit.timer.elapsedTime, timings: this.circuit.checkpoints.timings.slice() }
+            this.playing = false
+            this.flash(`Arrivée : ${formatTime(this.finish.time)} (image ${after})`)
+        }
+    }
+
+    fromTasInput(input)
+    {
+        return {
+            throttle: input.throttle || 0,
+            steer: input.steer || 0,
+            boost: !!input.boost,
+            brake: !!input.brake,
+            susp: isAllLow(input.susp) ? null : input.susp.slice()
+        }
+    }
+
+    extendMovie(length)
+    {
+        while(this.movie.length < length)
+            this.movie.push({ ...NEUTRAL })
+    }
+
+    trimGreenzone()
+    {
+        if(this.greenzone.size <= GREEN_MAX) return
+        const current = this.current
+        const keys = [ ...this.greenzone.keys() ].filter(k => k !== 0).sort((a, b) => Math.abs(b - current) - Math.abs(a - current))
+        while(this.greenzone.size > GREEN_MAX)
+            this.greenzone.delete(keys.shift())
+    }
+
+    trimFineCache()
+    {
+        if(this.fineCache.size <= FINE_MAX) return
+        const current = this.current
+        const keys = [ ...this.fineCache.keys() ].sort((a, b) => Math.abs(b - current) - Math.abs(a - current))
+        while(this.fineCache.size > FINE_MAX) this.fineCache.delete(keys.shift())
+    }
+
+    invalidateAfter(index)
+    {
+        for(const key of [ ...this.greenzone.keys() ])
+            if(key > index) this.greenzone.delete(key)
+        for(const key of [ ...this.fineCache.keys() ])
+            if(key > index) this.fineCache.delete(key)
+        if(this.finish && this.finish.frame > index) this.finish = null
+    }
+
+    /**
+     * Aller à une image (restaure le savestate le plus proche puis rejoue sans affichage)
+     */
+    seek(target, { force = false, render = true } = {})
+    {
+        target = Math.max(0, Math.round(target))
+        const current = this.current
+        if(target === current && !force) return
+
+        const wasRecording = this.recording
+        this.recording = false
+
+        this.silent(() =>
+        {
+            // Point de départ : savestate le plus proche avant la cible (une image avant si possible, pour l'affichage)
+            const limit = target > 0 ? target - 1 : 0
+            let best = 0, bestState = this.greenzone.get(0)
+            for(const [ key, state ] of this.greenzone)
+                if(key <= limit && key > best) { best = key; bestState = state }
+            for(const [ key, state ] of this.fineCache)
+                if(key <= limit && key > best) { best = key; bestState = state }
+
+            const canContinue = !force && target > current && current >= best
+            if(!canContinue)
+                this.tas.loadState(bestState)
+
+            // En rejouant, on garde des savestates rapprochés juste avant la cible : le prochain retour
+            // d'une image n'aura presque rien à recalculer
+            while(this.current < target)
+            {
+                this.stepOne(false)
+                const index = this.current
+                if(index < target && index > target - FINE_INTERVAL * 5 && index % FINE_INTERVAL === 0 && !this.greenzone.has(index) && !this.fineCache.has(index) && this.tas.isSafeFrame())
+                    this.fineCache.set(index, this.tas.saveState())
+            }
+            this.trimFineCache()
+        })
+
+        this.recording = wasRecording
+        if(render) this.renderNow()
+    }
+
+    resync(fromIndex)
+    {
+        this.invalidateAfter(fromIndex)
+        if(this.current > fromIndex)
+            this.seek(this.current, { force: true })
+    }
+
+    /**
+     * Édition
+     */
+    pushHistory(indices)
+    {
+        this.rowsDirty = true
+        const entry = indices.map(i => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history.length = this.historyIndex + 1
+        this.history.push({ entry, length: this.movie.length })
+        if(this.history.length > 500) this.history.shift()
+        this.historyIndex = this.history.length - 1
+    }
+
+    undo()
+    {
+        if(this.historyIndex < 0) return
+        const { entry, length } = this.history[this.historyIndex]
+        const redo = entry.map(([ i ]) => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history[this.historyIndex] = { entry: redo, length: this.movie.length, undone: true }
+        this.historyIndex--
+        let min = Infinity
+        for(const [ i, value ] of entry)
+        {
+            min = Math.min(min, i)
+            if(value) this.movie[i] = value
+        }
+        this.movie.length = Math.max(length, 0)
+        this.extendMovie(length)
+        this.dirty = true
+        this.resync(isFinite(min) ? min : 0)
+        this.flash('Annulé')
+    }
+
+    redo()
+    {
+        if(this.historyIndex >= this.history.length - 1) return
+        this.historyIndex++
+        const { entry, length } = this.history[this.historyIndex]
+        const back = entry.map(([ i ]) => [ i, this.movie[i] ? { ...this.movie[i] } : null ])
+        this.history[this.historyIndex] = { entry: back, length: this.movie.length }
+        let min = Infinity
+        for(const [ i, value ] of entry)
+        {
+            min = Math.min(min, i)
+            if(value) this.movie[i] = value
+        }
+        this.movie.length = length
+        this.extendMovie(length)
+        this.dirty = true
+        this.resync(isFinite(min) ? min : 0)
+        this.flash('Rétabli')
+    }
+
+    setInputs(indices, patch, { resync = true } = {})
+    {
+        this.rowsDirty = true
+        if(!indices.length) return
+        const max = Math.max(...indices)
+        this.extendMovie(max + 1)
+        this.pushHistory(indices)
+        for(const i of indices)
+            this.movie[i] = { ...this.movie[i], ...(typeof patch === 'function' ? patch(this.movie[i], i) : patch) }
+        this.dirty = true
+        if(resync) this.resync(Math.min(...indices))
+    }
+
+    insertFrame()
+    {
+        const index = this.current
+        this.pushHistory(Array.from({ length: Math.max(0, this.movie.length - index + 1) }, (_, k) => index + k))
+        this.movie.splice(index, 0, { ...NEUTRAL })
+        this.dirty = true
+        this.resync(index)
+        this.flash(`Image insérée à ${index}`)
+    }
+
+    deleteFrame()
+    {
+        const index = this.current
+        if(index >= this.movie.length) return
+        this.pushHistory(Array.from({ length: this.movie.length - index }, (_, k) => index + k))
+        this.movie.splice(index, 1)
+        this.dirty = true
+        this.resync(index)
+        this.flash(`Image ${index} supprimée`)
+    }
+
+    truncate()
+    {
+        const index = this.current
+        if(index >= this.movie.length) return
+        this.pushHistory(Array.from({ length: this.movie.length - index }, (_, k) => index + k))
+        this.movie.length = index
+        this.dirty = true
+        this.invalidateAfter(index)
+        this.flash(`Movie coupé après l'image ${index - 1}`)
+    }
+
+    /**
+     * Fichiers
+     */
+    serialize()
+    {
+        return {
+            format: 'bs-folio-tas-movie',
+            version: 2, // v2 : l'image 0 est l'image du départ (v1 : l'image suivante)
+            game: 'brunosimon/folio-2025',
+            course: this.course,
+            ...(TRACKS[this.course] ? { track: TRACKS[this.course] } : {}),
+            fps: this.tas.fps,
+            result: this.finish ? { frames: this.finish.frame, time: this.finish.time, timings: this.finish.timings } : null,
+            inputs: this.movie.map(i => [ i.throttle, i.steer, i.boost ? 1 : 0, i.brake ? 1 : 0, i.susp ? i.susp.map(s => s[0]).join('') : '' ])
+        }
+    }
+
+    deserialize(data)
+    {
+        if(!data || data.format !== 'bs-folio-tas-movie' || !Array.isArray(data.inputs))
+            throw new Error('Fichier non reconnu (format bs-folio-tas-movie attendu)')
+        const map = { l: 'low', m: 'mid', h: 'high' }
+        const movie = data.inputs.map(([ throttle, steer, boost, brake, susp ]) => ({
+            throttle: +throttle || 0,
+            steer: +steer || 0,
+            boost: !!boost,
+            brake: !!brake,
+            susp: susp && susp !== 'llll' ? [ ...susp ].map(c => map[c] || 'low') : null
+        }))
+        // Movies v1 (éditeur 1.1.0) : leur image 0 tombait une image après le départ
+        if((data.version || 1) < 2) movie.unshift({ ...NEUTRAL })
+        return movie
+    }
+
+    loadMovie(movie, label)
+    {
+        this.movie = movie
+        this.history = []
+        this.historyIndex = -1
+        this.finish = null
+        this.playing = false
+        this.recording = false
+        this.dirty = true   // le movie ouvert devient le travail en cours (sauvegardé automatiquement)
+        this.invalidateAfter(0)
+        this.seek(0, { force: true })
+        if(label) this.flash(label)
+    }
+
+    saveFile()
+    {

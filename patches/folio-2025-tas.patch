+import * as THREE from 'three/webgpu'
+import { Game } from '../Game.js'
+
+/**
+ * Île aplanie (Grand tour) : tout ce qui est hors du circuit de base est retiré pendant la course
+ * (arbres, buissons, rochers, bâtiments, zones et leur décor, objets mobiles…) puis remis à la fin.
+ * - zone conservée : la piste du circuit de base (entre ses barrières) et MARGIN mètres de part et d'autre des barrières
+ * - physique : les objets du jeu hors de la zone sont désactivés (objects.disable)
+ * - affichage : les éléments de la scène entièrement hors de la zone sont détachés ; pour les maillages
+ *   « instanciés » (arbres, buissons, fleurs…), seules les instances hors de la zone sont masquées
+ * Le sol, l'eau, l'herbe, le ciel, la voiture, les effets (pluie, confettis…) et le circuit ne sont pas touchés.
+ */
+const MARGIN = 3
+const CELL = 0.5
+
+export class Flatten
+{
+    constructor()
+    {
+        this.game = Game.getInstance()
+        this.applied = false
+        this.mask = null
+    }
+
+    // Grille de la zone conservée : la piste (remplissage depuis la ligne de départ, limité par les barrières)
+    // plus une bande de MARGIN mètres autour des barrières ; table cumulée pour tester un rectangle d'un coup
+    setMask()
+    {
+        const circuit = this.game.world.areas.circuit
+        const half = this.game.terrain.size / 2
+        const n = Math.ceil(this.game.terrain.size / CELL)
+        const keep = new Uint8Array(n * n)
+        const wall = new Uint8Array(n * n)
+        const collider = circuit.rails.collider
+        const v = collider.vertices(), index = collider.indices(), t = collider.translation()
+        const mark = (ax, az, bx, bz, radius, target) =>
+        {
+            const minX = Math.min(ax, bx) - radius, maxX = Math.max(ax, bx) + radius
+            const minZ = Math.min(az, bz) - radius, maxZ = Math.max(az, bz) + radius
+            const dx = bx - ax, dz = bz - az, length2 = dx * dx + dz * dz || 1
+            for(let iz = Math.max(0, Math.floor((minZ + half) / CELL)); iz <= Math.min(n - 1, Math.floor((maxZ + half) / CELL)); iz++)
+                for(let ix = Math.max(0, Math.floor((minX + half) / CELL)); ix <= Math.min(n - 1, Math.floor((maxX + half) / CELL)); ix++)
+                {
+                    const x = -half + (ix + 0.5) * CELL, z = -half + (iz + 0.5) * CELL
+                    const u = Math.max(0, Math.min(1, ((x - ax) * dx + (z - az) * dz) / length2))
+                    const ex = ax + dx * u - x, ez = az + dz * u - z
+                    if(ex * ex + ez * ez <= radius * radius) target[iz * n + ix] = 1
+                }
+        }
+        for(let i = 0; i < index.length; i += 3)
+            for(let k = 0; k < 3; k++)
+            {
+                const a = index[i + k], b = index[i + (k + 1) % 3]
+                const ax = v[a * 3] + t.x, az = v[a * 3 + 2] + t.z, bx = v[b * 3] + t.x, bz = v[b * 3 + 2] + t.z
+                mark(ax, az, bx, bz, CELL * 0.8, wall)
+                mark(ax, az, bx, bz, MARGIN, keep)
+            }
+
+        // piste : remplissage depuis la ligne de départ sans traverser les barrières
+        const start = circuit.checkpoints.items[0].position
+        const track = new Uint8Array(n * n)
+        const queue = [ Math.floor((start.z + half) / CELL) * n + Math.floor((start.x + half) / CELL) ]
+        track[queue[0]] = 1
+        let filled = 0
+        while(queue.length)
+        {
+            const c = queue.pop(); filled++
+            const cx = c % n, cz = (c - cx) / n
+            for(const [ ox, oz ] of [ [ 1, 0 ], [ -1, 0 ], [ 0, 1 ], [ 0, -1 ] ])
+            {
+                const x = cx + ox, z = cz + oz
+                if(x < 0 || z < 0 || x >= n || z >= n) continue
+                const k = z * n + x
+                if(track[k] || wall[k]) continue
+                track[k] = 1
+                queue.push(k)
+            }
+        }
+        // si les barrières ne ferment pas la piste, le remplissage déborde sur l'île : on s'en passe
+        this.trackFilled = filled / (n * n)
+        if(this.trackFilled < 0.5)
+            for(let k = 0; k < n * n; k++) if(track[k]) keep[k] = 1
+        // table cumulée
+        const sum = new Int32Array((n + 1) * (n + 1))
+        for(let iz = 0; iz < n; iz++)
+            for(let ix = 0; ix < n; ix++)
+                sum[(iz + 1) * (n + 1) + ix + 1] = keep[iz * n + ix] + sum[iz * (n + 1) + ix + 1] + sum[(iz + 1) * (n + 1) + ix] - sum[iz * (n + 1) + ix]
+        this.mask = { n, half, keep, sum }
+    }
+
+    keepsPoint(x, z)
+    {
+        const { n, half, keep } = this.mask
+        const ix = Math.floor((x + half) / CELL), iz = Math.floor((z + half) / CELL)
+        if(ix < 0 || iz < 0 || ix >= n || iz >= n) return false
+        return keep[iz * n + ix] === 1
+    }
+
+    // Le rectangle (au sol) touche-t-il la zone conservée ?
+    touchesBox(minX, minZ, maxX, maxZ)
+    {
+        const { n, half, sum } = this.mask
+        const x0 = Math.max(0, Math.floor((minX + half) / CELL)), z0 = Math.max(0, Math.floor((minZ + half) / CELL))
+        const x1 = Math.min(n - 1, Math.floor((maxX + half) / CELL)), z1 = Math.min(n - 1, Math.floor((maxZ + half) / CELL))
+        if(x1 < x0 || z1 < z0) return false
+        const w = n + 1
+        return sum[(z1 + 1) * w + x1 + 1] - sum[z0 * w + x1 + 1] - sum[(z1 + 1) * w + x0] + sum[z0 * w + x0] > 0
+    }
+
+    // Éléments à ne jamais toucher (sol, eau, herbe, effets, voiture, circuit…)
+    collectExcluded()
+    {
+        const excluded = new Set()
+        const add = (value, depth) =>
+        {
+            if(!value || typeof value !== 'object' || depth < 0) return
+            if(value.isObject3D) { excluded.add(value); return }
+            if(Array.isArray(value)) { for(const item of value) add(item, depth - 1); return }
+            if(value instanceof Map) { for(const item of value.values()) add(item, depth - 1); return }
+            if(Object.getPrototypeOf(value) !== Object.prototype && depth < 3) return
+            for(const key of Object.keys(value)) if(key !== 'game') add(value[key], depth - 1)
+        }
+        const world = this.game.world
+        for(const key of [ 'visualVehicle', 'floor', 'waterSurface', 'grass', 'windLines', 'confetti', 'leaves', 'rain', 'lightnings', 'fireballs', 'snow', 'visualTornado', 'grid', 'intro' ])
+            add(world[key], 4)
+        add(this.game.world.scenery?.road, 3)
+        const circuit = world.areas.circuit
+        add(circuit.model, 1)
+        add(circuit.checkpoints, 3)
+        add(circuit.guide, 2)
+        add(circuit.rails, 2)
+        return excluded
+    }
+
+    // Maillages instanciés dont les matrices sont dans un attribut à part (Foliage, Flowers…)
+    collectCustomInstanceMatrices()
+    {
+        const map = new Map()
+        const seen = new Set()
+        const scan = (value, depth) =>
+        {
+            if(!value || typeof value !== 'object' || depth < 0 || seen.has(value) || value.isObject3D) return
+            seen.add(value)
+            if(value.mesh?.isInstancedMesh && value.instanceMatrix?.isInstancedBufferAttribute && value.instanceMatrix !== value.mesh.instanceMatrix && value.instanceMatrix.itemSize === 16)
+                map.set(value.mesh, value.instanceMatrix)
+            if(Array.isArray(value)) { for(const item of value) scan(item, depth - 1); return }
+            if(Object.getPrototypeOf(value) !== Object.prototype && depth < 2) return
+            for(const key of Object.keys(value)) if(key !== 'game') scan(value[key], depth - 1)
+        }
+        scan(this.game.world, 4)
+        return map
+    }
+
+    apply()
+    {
+        if(this.applied) return
+        this.applied = true
+        if(!this.mask) this.setMask()
+
+        const objects = this.game.objects
+        const circuit = this.game.world.areas.circuit
+        const keepBodies = new Set([
+            this.game.world.floor?.physical?.body?.handle,
+            this.game.world.floor?.bedRock?.physical?.body?.handle,
+            circuit.roadBody?.handle,
+            circuit.rails?.object?.physical?.body?.handle,
+            this.game.physicalVehicle?.chassis?.physical?.body?.handle
+        ])
+        const crates = new Set(this.game.world.explosiveCrates?.items.map(crate => crate.object) || [])
+
+        const excluded = this.collectExcluded()
+        const isExcluded = (node) => { for(let n = node; n; n = n.parent) if(excluded.has(n)) return true; return false }
+
+        // 1. Objets du jeu (physique + affichage)
+        this.disabledObjects = []
+        const box = new THREE.Box3()
+        objects.list.forEach((object) =>
+        {
+            if(!object.physical || crates.has(object)) return
+            const body = object.physical.body
+            if(keepBodies.has(body.handle) || !body.isEnabled() || (object.visual?.object3D && isExcluded(object.visual.object3D))) return
+            let touches
+            if(object.visual?.object3D)
+            {
+                box.setFromObject(object.visual.object3D)
+                touches = box.isEmpty() ? this.keepsPoint(body.translation().x, body.translation().z) : this.touchesBox(box.min.x, box.min.z, box.max.x, box.max.z)
+            }
+            else
+                touches = this.keepsPoint(body.translation().x, body.translation().z)
+            if(touches) return
+            objects.disable(object)
+            this.disabledObjects.push(object)
+        })
+
+        // 2. Affichage : décor hors de la zone
+        const customMatrices = this.collectCustomInstanceMatrices()
+        this.detached = []
+        this.hiddenInstances = []
+        const zero = new THREE.Matrix4().makeScale(0, 0, 0)
+        const matrix = new THREE.Matrix4(), position = new THREE.Vector3()
+        const visit = (node) =>
+        {
+            if(excluded.has(node)) return
+            box.setFromObject(node)
+            if(box.isEmpty())
+            {
+                for(const child of [ ...node.children ]) visit(child)
+                return
+            }
+            const huge = box.max.x - box.min.x > 150 || box.max.z - box.min.z > 150
+            if(!huge && !this.touchesBox(box.min.x, box.min.z, box.max.x, box.max.z))
+            {
+                // les zones lisent geometry.boundingSphere quand elles reviennent dans le champ ; il n'est calculé qu'au
+                // premier rendu, qui n'a peut-être jamais eu lieu (Grand tour lancé avant d'avoir vu la zone)
+                node.traverse((child) => { if(child.geometry && !child.geometry.boundingSphere) child.geometry.computeBoundingSphere() })
+                this.detached.push({ node, parent: node.parent })
+                node.removeFromParent()
+                return
+            }
+            if(node.isInstancedMesh)
+            {
+                node.updateMatrixWorld()
+                // feuillages et fleurs : matrices dans un attribut à eux (lu par leur shader)
+                const attribute = customMatrices.get(node) || node.instanceMatrix
+                const hidden = []
+                for(let i = 0; i < node.count; i++)
+                {
+                    matrix.fromArray(attribute.array, i * 16)
+                    position.setFromMatrixPosition(matrix).applyMatrix4(node.matrixWorld)
+                    if(!this.keepsPoint(position.x, position.z))
+                    {
+                        hidden.push([ i, matrix.clone() ])
+                        zero.toArray(attribute.array, i * 16)
+                    }
+                }
+                if(hidden.length)
+                {
+                    attribute.needsUpdate = true
+                    this.hiddenInstances.push({ node, attribute, hidden })
+                }
+                return
+            }
+            for(const child of [ ...node.children ]) visit(child)
+        }
+        for(const child of [ ...this.game.scene.children ]) visit(child)
+    }
+
+    revert()
+    {
+        if(!this.applied) return
+        this.applied = false
+        for(const { attribute, hidden } of this.hiddenInstances.reverse())
+        {
+            for(const [ i, matrix ] of hidden) matrix.toArray(attribute.array, i * 16)
+            attribute.needsUpdate = true
+        }
+        for(const { node, parent } of this.detached.reverse())
+            if(parent && !node.parent) parent.add(node)
+        for(const object of this.disabledObjects.reverse())
+            this.game.objects.enable(object)
+        this.hiddenInstances = []
+        this.detached = []
+        this.disabledObjects = []
+    }
+}

{
  "name": "bs-folio-race",
  "productName": "BS Folio Race",
  "version": "1.4.1",
  "description": "Portfolio 2025 de Bruno Simon (MIT) empaqueté pour Linux/Windows, avec éditeur TAS",
  "main": "main.cjs",
  "author": "Victor Zano",
  "license": "MIT",
  "build": {
    "appId": "fr.victor.bsfoliorace",
    "productName": "BS Folio Race",
    "files": [
      "main.cjs",
      "app/**/*",
      "LICENSE-folio-2025.md"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "BS-Folio-Race-${version}-x86_64.${ext}"
    },
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "BS-Folio-Race-${version}-win-x64.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "desktopName": "bs-folio-race.desktop"
}